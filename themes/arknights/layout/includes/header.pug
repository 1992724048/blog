mixin expand_list(list)
  each url, label in list
    - var match = null
    if typeof(url) === "string" && url.match(config.archive_dir)
      - match = config.category_dir + ',' + config.tag_dir
    li.navItem(matchdata=match)
      if typeof(url) === "object"
        .navSecond
          span.navItemTitle= label
          ol.navItemList
            +expand_list(url)
      else
        a.navSecond(href= url_for(url))
          span.navItemTitle= label

header.topbar
  button.navBtn(type="button" aria-label=__('page.expandNav') aria-expanded="false")
    i.navBtnIcon
      span.navBtnIconBar
      span.navBtnIconBar
      span.navBtnIconBar
  nav
    ol.navContent
      - var finalMenu = {}
      each url, label in theme.menu
        - finalMenu[url_for(url)] = {url: url, label: label}
      if config.menu
        each url, label in config.menu
          - finalMenu[url_for(url)] = {url: url, label: label}
      each item in Object.values(finalMenu)
        - var match = null
        if typeof(item.url) === "string" && item.url.match(config.archive_dir)
          - match = config.category_dir + ',' + config.tag_dir
        li.navItem(matchdata=match)
          if typeof(item.url) === "object"
            .navBlock
              span.navItemTitle= item.label
              ol.navItemList
                +expand_list(item.url)
          else
            a.navBlock(href= url_for(item.url))
              span.navItemTitle= item.label
    if searchConfig !== null
      .navItem#search-header
        span.navItemTitle
          input(autocomplete="off" autocorrect="off" autocapitalize="none"
            placeholder=__('search.blurHolder') aria-label=__('search.blurHolder')
            spellcheck="false" maxlength="50" type="text" id="search-input")
      .search-popup(tabindex="0")
        #search-result
  if searchConfig !== null
    button.searchBtn(type="button" aria-label=__('search.blurHolder'))
      svg.searchBtnIcon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
        circle(cx="11" cy="11" r="8")
        path(d="M21 21l-4.35-4.35")
