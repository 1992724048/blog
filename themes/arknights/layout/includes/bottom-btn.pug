//- 底部按钮组：右列 .bottom-btn-stack 单列 flex 栈（DOM 顺序即视觉顺序）；工具箱独立锚定左下角（与 #color-mode 底缘齐平）；本阶段只提供静态 DOM，业务交互由后续 document 委托接线
.bottom-btn
  .bottom-btn-stack
    button#to-top.i-top(type="button" onClick="scrolls.scrolltop();" title=__('btn.totop') aria-label=__('btn.totop') style="opacity: 0; display: none;")
      svg.i-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
        path(d="M12 19V5M5 12l7-7 7 7")
    button#to-back.i-back(type="button" onclick="history.back();" title=__('btn.back') aria-label=__('btn.back'))
      svg.i-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
        path(d="M19 12H5M12 19l-7-7 7-7")
    if page.content
      - const encrypted = page.encrypt || page.password
      - const tocContent = encrypted === undefined ? toc(page.content, theme.toc) : toc(page.origin, theme.toc)
      if tocContent.length > 0
        button#to-index.i-index(type="button" onClick="tocControl.change()" title=__('btn.index') aria-label=__('btn.index'))
          span.tocBtnIconBar
          span.tocBtnIconBar
          span.tocBtnIconBar
    if theme.color !== 'dark-only' && theme.color !== 'light-only'
      button#color-mode.i-color(type="button" onClick="colorMode.change()" title=__('btn.colorMode') aria-label=__('btn.colorMode'))
        svg.i-icon.i-moon(viewBox="0 0 24 24" fill="currentColor" aria-hidden="true")
          path(d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z")
        svg.i-icon.i-sun(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
          circle(cx="12" cy="12" r="5")
          path(d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42")
  .toolbox
    button#to-toolbox.toolbox-toggle(type="button" data-action="toolbox" aria-expanded="false" aria-controls="toolbox-items" title=__('btn.toolbox') aria-label=__('btn.toolbox'))
      svg.i-icon.i-toolbox(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
        path(d="M2 9a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z")
        path(d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2")
        path(d="M2 13h20")
    .toolbox-items#toolbox-items
      button.toolbox-item.toolbox-annotate(type="button" data-action="annotate" title=__('btn.annotate') aria-label=__('btn.annotate') aria-pressed="false")
        svg.i-icon.i-annotate(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
          path(d="m9 11-6 6v3h9l3-3")
          path(d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4")
      button.toolbox-item.toolbox-share(type="button" data-action="share" title=__('btn.share') aria-label=__('btn.share'))
        svg.i-icon.i-share(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
          circle(cx="18" cy="5" r="3")
          circle(cx="6" cy="12" r="3")
          circle(cx="18" cy="19" r="3")
          path(d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98")
        svg.i-icon.i-check(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
          path(d="M20 6L9 17l-5-5")
      button.toolbox-item.toolbox-favorite(type="button" data-action="favorite" title=__('btn.favorite') aria-label=__('btn.favorite') aria-pressed="false" data-label-default=__('btn.favorite') data-label-saved=__('btn.favorited'))
        svg.i-icon.i-star(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
          polygon(points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2")
      if is_post()
        button.toolbox-item.toolbox-screenshot(type="button" data-action="screenshot" data-snapdom-src=url_for('/lib/snapdom/3.1.1/snapdom.min.js') title=__('toolbox.screenshot') aria-label=__('toolbox.screenshot') aria-busy="false")
      if theme.bgm.enable
        button.toolbox-item.toolbox-bgm(type="button" data-action="bgm" title=__('toolbox.bgmPlay') aria-label=__('toolbox.bgmPlay') aria-pressed="false")
    .toolbox-status(role="status" aria-live="polite" aria-atomic="true" hidden)
  //- 选中文字工具栏（Word 式浮动条）：仅标注模式（body.annotating）下选中文字时由 JS 定位显示（类 .open）
  //- 定位口径与样式契约见 bottom_btn.styl「选中文字工具栏」段；默认隐藏（visibility hidden，不可 Tab 聚焦）
  #annotate-toolbar(role="toolbar" aria-hidden="true")
    button.at-btn.at-annotate(type="button" title=__('btn.annotate') aria-label=__('btn.annotate'))
      svg.at-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
        path(d="m9 11-6 6v3h9l3-3")
        path(d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4")
    button.at-btn.at-clear(type="button" title=__('btn.clear') aria-label=__('btn.clear'))
      svg.at-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
        path(d="M3 6h18")
        path(d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2")
        path(d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6")
    button.at-btn.at-copy(type="button" title=__('btn.copy') aria-label=__('btn.copy'))
      svg.at-icon.i-copy(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
        rect(x="9" y="9" width="12" height="12" rx="2")
        path(d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1")
      svg.at-icon.i-check(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
        path(d="M20 6L9 17l-5-5")
    button.at-btn.at-search(type="button" title=__('btn.search') aria-label=__('btn.search'))
      svg.at-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
        circle(cx="11" cy="11" r="8")
        path(d="M21 21l-4.35-4.35")
    button.at-btn.at-color(type="button" data-color="yellow" title=__('btn.color') aria-label=__('btn.color'))
      span.at-color-fill
    .at-colors
      each colorName in ['yellow', 'green', 'blue', 'pink', 'orange']
        button.at-color-opt(type="button" data-color=colorName class= colorName === 'yellow' ? 'active' : null title=colorName aria-label=colorName)
