meta(charset='UTF-8')
meta(name='viewport' content='width=device-width, initial-scale=1.0')
title= pageTitle
- var keywords = page.keywords || page.tags && page.tags.map(function(t){return t.name}).join(',') || config.keywords || ''
- var canonical = (typeof url !== 'undefined' && url) || (typeof full_url_for === 'function' ? full_url_for(page.path || '/') : '')
- canonical = canonical ? canonical.replace(/index\.html$/, '') : canonical
- if (!String(config.permalink || '').endsWith('.html')) canonical = canonical ? canonical.replace(/\.html$/, '') : canonical
if keywords
  meta(name="keywords" content=typeof keywords === 'string' ? keywords : keywords.join(','))
!= open_graph({twitter_id: theme.twitter, google_plus: theme.google_plus, fb_admins: theme.fb_admins, fb_app_id: theme.fb_app_id})
if canonical
  link(rel="canonical" href=canonical)
if page.noindex
  meta(name="robots" content="noindex")
link(
  rel="icon"
  type=(theme.favicon.type ? theme.favicon.type : "image/x-icon")
  href=(url_for(theme.favicon.href ? theme.favicon.href : "favicon.ico"))
)

link(rel="preload", as="font", crossorigin="anonymous", href=url_for("font/Bender.ttf"))
link(rel="preload", as="font", crossorigin="anonymous", href=url_for("font/BenderLight.woff2"))
link(rel="preload", as="font", crossorigin="anonymous", href=url_for('font/JetBrainsMono-Regular.woff2'))
//- 中文字体：HarmonyOS Sans SC 分包 CSS（jsDelivr CDN，版本锁定 1.1.0，unicode-range 按需加载）
//- 非阻塞引入：media="print" 让浏览器以非渲染阻塞优先级下载，onload 切回 all 生效；
//- noscript 回退保证禁用 JS 时字体 CSS 仍同步生效（回退路径会重新引入阻塞，是刻意的正确性取舍）
link(rel='preconnect', href='https://cdn.jsdelivr.net', crossorigin)
//- 第三方域预连接：把 DNS / TCP / TLS 往返前置到 HTML 解析期，缩短首屏第三方资源的等待
//- href 取协议相对形式，与下文实际引用的 `//unpkg.com/...`、`//cdnjs...` 同源，
//- 保证 http / https 两种部署下提示都落在真正被请求的那个源上，不会白建连接
//- 不加 crossorigin：本主题对这两个域的引用全是 `<link rel=stylesheet>` 与经典 `<script>`（no-cors 连接池），
//- 加了 crossorigin 反而会改建 CORS 池连接而无法被这些请求复用（同理 jsDelivr 那条带 crossorigin，
//- 是因为它服务的是 webfont，字体必须走 CORS）
link(rel='preconnect', href='//unpkg.com')
link(rel='preconnect', href='//cdnjs.cloudflare.com')
//- Cloudflare Browser Insights（static.cloudflareinsights.com）由边缘注入、不在本仓源码内，
//- 无法在本地构建中验证，故只给最廉价的 DNS 提示（不占连接）；该功能未启用时提示自动失效
link(rel='dns-prefetch', href='//static.cloudflareinsights.com')
link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/harmonyos-sans-sc-webfont-splitted@1.1.0/dist/Regular.css' media='print' onload="this.media='all'")
link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/harmonyos-sans-sc-webfont-splitted@1.1.0/dist/Bold.css' media='print' onload="this.media='all'")
noscript
  link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/harmonyos-sans-sc-webfont-splitted@1.1.0/dist/Regular.css')
  link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/harmonyos-sans-sc-webfont-splitted@1.1.0/dist/Bold.css')
//- 缓存版本号：修改主题 Stylus（arknights.css 产物）后同步递增，避免 Cloudflare / 浏览器缓存旧版
- var cssVersion = "20260962"
link(rel="stylesheet", href=url_for("css/arknights.css") + "?v=" + cssVersion)
style.
  //- font-display 取值依据（均为 swap，相对原「未声明 ≈ block、最长 3s 不可见」是双向改善）：
  //- Bender / BenderLight 是展示字体（站点字标 + 文章与分区标题），缺失即品牌与排版失真，
  //- 两者又都已被 preload 提前取回、阻塞窗口很短，故要「最终一定生效」而非 optional 的整轮放弃；
  //- 代价是标题字宽变化带来的轻微重排，相对 3s 空白不可见是数量级更小的代价。
  //- JetBrains Mono 是代码字体（正文代码块），swap 到等宽回退时逐字宽度基本一致，CLS 近乎为零，
  //- 且 optional 一旦抢跑失败会让整篇文章的代码在本次会话永久退回系统等宽，故取 swap。
  @font-face {
    font-family: Bender;
    src: local('Bender'), url("#{config.root}font/Bender.ttf");
    font-display: swap;
  }
  @font-face {
    font-family: BenderLight;
    src: local('BenderLight'), url("#{config.root}font/BenderLight.woff2") format('woff2');
    font-display: swap;
  }
  @font-face {
    font-family: 'JetBrains Mono';
    src: local('JetBrains Mono'), url('#{config.root}font/JetBrainsMono-Regular.woff2') format('woff2');
    font-display: swap;
  }

meta(name="page-config" content=JSON.stringify({ code_fold: page.code_fold || null }))

if theme.giscus && theme.giscus.enable === true && theme.giscus.backlink
  meta(name="giscus:backlink" content=theme.giscus.backlink)

script(class="pjax-js").
  var config = !{configs};
  var page_config = {
    code_fold: !{JSON.stringify(page.code_fold || null)}
  };
  function updatePageConfig() {
    var newPageConfig = document.querySelector('meta[name="page-config"]');
    if (newPageConfig) {
      page_config = JSON.parse(newPageConfig.content);
    }
  }
  document.addEventListener('pjax:complete', function() { updatePageConfig(); });
  updatePageConfig();
if theme.waline && theme.waline.enable === true
  link(rel="stylesheet", href= url_for('//unpkg.com/@waline/client@v2/dist/waline.css'))
link(type="text/css" rel="stylesheet" href=url_for("/lib/encrypt/hbe.style.css"))
if theme.artalk && theme.artalk.enable === true
  link(type="text/css" rel="stylesheet" href="//unpkg.com/artalk@2.8.4/dist/Artalk.css")
  script(async src="//unpkg.com/artalk@2.8.4/dist/Artalk.js")
if theme.mermaid && theme.mermaid.enable === true && theme.mermaid.version
  script(src= "//unpkg.com/mermaid@" + theme.mermaid.version + "/dist/mermaid.min.js")
link(type="text/css" rel="stylesheet" href="//unpkg.com/lightgallery@2.7.1/css/lightgallery.css")
link(type="text/css" rel="stylesheet" href="//unpkg.com/lightgallery@2.7.1/css/lg-zoom.css")
link(type="text/css" rel="stylesheet" href="//unpkg.com/lightgallery@2.7.1/css/lg-thumbnail.css")
//- vendored FontAwesome CSS 同挂 cssVersion：它是版本化产物之外的另一份主题 CSS 资产，
//- 本地定制（裁掉未用字重的 @font-face）必须能被 Cloudflare / 浏览器缓存正确失效
link(type="text/css" rel="stylesheet" href=url_for("/lib/fontawesome/css/all.min.css") + "?v=" + cssVersion)


if theme.stylesheets && theme.stylesheets.length > 0
  //- stylesheets list from _config.yml
  each url in theme.stylesheets
    if url
      if url[0] === '{' && url[url.length - 1] === '}'
        style!=url.substr(1, url.length - 2)
      else
        link(rel='stylesheet', href=url)
script
  |if (window.localStorage.getItem('theme-mode') === 'light'
  if theme.color === 'auto'
    |  || window.matchMedia('(prefers-color-scheme:light)').matches
  |)
  |  document.documentElement.setAttribute('theme-mode', 'light')
  |if (window.localStorage.getItem('theme-mode') === 'dark'
  if theme.color === 'auto'
    |  || window.matchMedia('(prefers-color-scheme:dark)').matches
  |)
  |  document.documentElement.setAttribute('theme-mode', 'dark')

include ./generate-css.pug
include ./js-data.pug
