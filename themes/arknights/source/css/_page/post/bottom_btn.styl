// 底部按钮组：右列单列 flex 栈（DOM 顺序即视觉顺序、数量可扩展，列内 gap 6px），工具箱独立锚定左下角；
// 两侧共用 --btn-inset 底部基线（8px）：工具箱 toggle 与 #color-mode 均为该基线内末位 40px 方框，底缘严格同行
.bottom-btn
  --btn-inset 8px
  position sticky
  bottom 0
  z-index 65536
  display flex
  flex-direction column
  align-items flex-end
  @media ( max-width 768px )
    position fixed
    left 0
    width 100vw
  .bottom-btn-stack
    position absolute
    right var(--btn-inset)
    bottom var(--btn-inset)
    display flex
    flex-direction column
    align-items flex-end
    gap 6px
  a, button
    position relative
    overflow hidden
    display flex
    align-items center
    justify-content center
    width 40px
    height 40px
    padding 0
    margin 0
    border 0
    border-radius 0
    background-color transparent
    color var(--theme-text-light)
    font-family inherit
    font-size 40px
    font-weight 900
    line-height 40px
    text-align center
    user-select none
    -webkit-tap-highlight-color transparent
    -webkit-appearance none
    appearance none
    transition background-color .2s, color .2s
    @media ( min-width 769px )
      &:hover
        background-color var(--theme-subcolor)
        color var(--theme-text-hover)
    &:active
      background-color var(--theme-subcolor)
      color var(--theme-text-hover)
    &:focus-visible
      outline 2px solid var(--theme-text-light)
      outline-offset 2px
.bottom-btn .i-top, .bottom-btn .i-back, .bottom-btn .i-color, .bottom-btn .toolbox-toggle, .bottom-btn .toolbox-item
  background-color var(--theme-bg-light)
  color var(--theme-text-rev)
.i-icon
  margin auto
  width 16px
  height 16px
  display block
  transition transform .3s
.bottom-btn .i-color
  @media ( min-width 769px )
    &:hover .i-icon
      transform rotate(90deg)
.i-index
  .tocBtnIconBar
    background-color var(--theme-text-light)
    width 25px
    position absolute
    top 50%
    width 24px
    height 0.1em
    text-indent 101%
    white-space nowrap
    overflow hidden
    transition transform ease-in-out 0.3s
    left 8px
    &:nth-child(1)
      transform translate(0, -250%)
    &:nth-child(2)
      transform translate(0, -50%)
    &:nth-child(3)
      transform translate(0, 150%)
  &.open .tocBtnIconBar
    &:nth-child(1)
      transform translate(0, -50%) rotate(45deg) scaleX(1.2)
    &:nth-child(2)
      transform translate(0, -50%) translateX(-300%)
    &:nth-child(3)
      transform translate(0, -50%) rotate(-45deg) scaleX(1.2)

// 工具箱：.toolbox 根承载展开态类 .toolbox-open（点击 / 外点 / Escape 切换由 JS 侧 toolbox.toggle() 负责）
// 独立锚定 .bottom-btn 左下角，与右列共用 --btn-inset 底部基线（桌面 sticky / ≤768 fixed 同锚）；
// .toolbox 高度 = 唯一常规子项 .toolbox-toggle（40px），故 toggle 底缘 = 基线 = #color-mode 底缘
// 扇形几何：以工具箱按钮为原点，半径 58px、角度 0° / 22.5° / 45° 向右上张开（各断点均在视口内；与右侧按钮列净空充足）
// 层叠规则：扇形容量 3 个；第 4 个起沿原点层叠成堆（不展开），随工具数量可扩展
.bottom-btn .toolbox
  position absolute
  // 视觉左间距 = 底部基线（8px）：补偿 .bottom-btn 所处 article 的左偏移（--toolbox-shift，各断点见下）
  left calc(var(--btn-inset) - var(--toolbox-shift, 0px))
  bottom var(--btn-inset)
  display flex
  flex-direction column
  align-items flex-start

// --toolbox-shift = article 相对视口的左偏移（对应 flex_layout.styl 的 article margin-left）；≤768px 不补偿（.bottom-btn 为 fixed left:0，视觉已等距）
@media ( min-width 769px )
  .bottom-btn
    --toolbox-shift 20px
@media ( min-width 1024px )
  .bottom-btn
    --toolbox-shift 25px
@media ( min-width 1912px )
  .bottom-btn
    --toolbox-shift 2.5vw
.bottom-btn .toolbox-toggle
  z-index 3
.bottom-btn .toolbox-open .toolbox-toggle
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .toolbox-items
  position absolute
  top 0
  right 0
  z-index 2
.bottom-btn .toolbox-item
  --fan-x 0px
  --fan-y 0px
  --pull-x 0px
  --pull-y 0px
  position absolute
  top 0
  right 0
  z-index 1
  opacity 0
  visibility hidden
  pointer-events none
  transform translate(0, 0)
  transition transform .24s cubic-bezier(.2, .8, .3, 1.1), opacity .18s ease-out, visibility 0s linear .24s, background-color .2s, color .2s, box-shadow .2s
.bottom-btn .toolbox-item:nth-child(1)
  --fan-x 58px
  --fan-y 0px
  --pull-x 10px
  --pull-y 0px
.bottom-btn .toolbox-item:nth-child(2)
  --fan-x 54px
  --fan-y -22px
  --pull-x 9px
  --pull-y -4px
.bottom-btn .toolbox-item:nth-child(3)
  --fan-x 41px
  --fan-y -41px
  --pull-x 7px
  --pull-y -7px
.bottom-btn .toolbox-item:nth-child(4)
  --fan-x 4px
  --fan-y -4px
.bottom-btn .toolbox-item:nth-child(n+5)
  --fan-x 8px
  --fan-y -8px
// 展开态（含层叠项）：轻微投影明确层级（深浅主题通用黑系阴影，克制）；悬停抽出态略强（见下）
.bottom-btn .toolbox-open .toolbox-item
  opacity 1
  visibility visible
  pointer-events auto
  transition-delay 0s
  transform translate(var(--fan-x), var(--fan-y))
  box-shadow 0 2px 8px rgba(0, 0, 0, .25)
@media ( min-width 769px )
  .bottom-btn .toolbox-open .toolbox-item:hover
    z-index 5
    box-shadow 0 4px 10px rgba(0, 0, 0, .35)
    transform translate(calc(var(--fan-x) + var(--pull-x)), calc(var(--fan-y) + var(--pull-y))) scale(1.08)

// ===== 标注模式与选中文字工具栏（Word 式浮动条）
// 标注模式（常驻开关，JS 挂类）：body.annotating 开启后文本区显示文本光标（提示可划选）；工具箱【标注】项同步点亮 .active
body.annotating
  cursor text
.bottom-btn .toolbox-annotate.active
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)

// 工具栏容器：仅标注模式下选中文字时显示（.open 由 JS 切换）；默认隐藏且不可 Tab 聚焦（visibility hidden）
// 定位口径（由 JS 计算，容器不参与定位计算、无 transform / margin 干扰）：
//   以 position: fixed 的视口坐标设置 left / top；
//   水平：left = 选区中心 x − 工具栏宽度 / 2（居中于选区，建议夹取到视口安全边距内）；
//   垂直：默认置顶于选区上方（top = 选区顶 − 工具栏高度 − 6px），上方空间不足时翻转到选区下方（top = 选区底 + 6px）
// z-index 65536：与 .bottom-btn 同层，低于 lightgallery（65537）与自定义光标（65538）——全屏查看器与光标始终覆盖工具栏
#annotate-toolbar
  position fixed
  z-index 65536
  display flex
  align-items stretch
  gap 1px
  padding 1px
  box-sizing border-box
  background-color var(--theme-text-rev)
  box-shadow 0 2px 8px rgba(0, 0, 0, .25)
  visibility hidden
  opacity 0
  transition opacity .15s, visibility 0s .15s
  &.open
    visibility visible
    opacity 1
    transition opacity .15s

// 按钮（缩小版主题按钮语言：--theme-bg-light 底 + --theme-text-rev 图标、直角；hover / active 主题黄底）
#annotate-toolbar .at-btn,
#annotate-toolbar .at-color-opt
  position relative
  display flex
  align-items center
  justify-content center
  box-sizing border-box
  width 22px
  height 22px
  padding 0
  margin 0
  border 0
  border-radius 0
  font-family inherit
  font-size 12px
  line-height 1
  user-select none
  -webkit-tap-highlight-color transparent
  -webkit-appearance none
  appearance none
  transition background-color .2s, color .2s

#annotate-toolbar .at-btn
  background-color var(--theme-bg-light)
  color var(--theme-text-rev)
  @media ( min-width 769px )
    &:hover
      background-color var(--theme-subcolor)
      color var(--theme-text-hover)
  &:active
    background-color var(--theme-subcolor)
    color var(--theme-text-hover)

// 图标 12px（22px 按钮内的协调尺寸，"比文字大一点"）；颜色随按钮 color，描边走 svg currentColor
#annotate-toolbar .at-icon
  display block
  width 12px
  height 12px

// 颜色按钮：1px 边框 + 内部填充当前色（默认黄；JS 更新按钮 data-color 即切换填充，映射见下）
#annotate-toolbar .at-color-fill
  box-sizing border-box
  width 14px
  height 14px
  border 1px solid var(--theme-text-rev)
  background-color var(--hl-yellow)
#annotate-toolbar .at-color[data-color=yellow] .at-color-fill
  background-color var(--hl-yellow)
#annotate-toolbar .at-color[data-color=green] .at-color-fill
  background-color var(--hl-green)
#annotate-toolbar .at-color[data-color=blue] .at-color-fill
  background-color var(--hl-blue)
#annotate-toolbar .at-color[data-color=pink] .at-color-fill
  background-color var(--hl-pink)
#annotate-toolbar .at-color[data-color=orange] .at-color-fill
  background-color var(--hl-orange)

// 颜色面板：默认隐藏，.open 由 JS 切换；右对齐于颜色按钮（工具栏右缘）下方 1px
#annotate-toolbar .at-colors
  position absolute
  top calc(100% + 1px)
  right 0
  display flex
  gap 1px
  padding 1px
  box-sizing border-box
  background-color var(--theme-text-rev)
  box-shadow 0 2px 8px rgba(0, 0, 0, .25)
  visibility hidden
  opacity 0
  transition opacity .15s, visibility 0s .15s
  &.open
    visibility visible
    opacity 1
    transition opacity .15s

// 色板选项：底色即对应标注色（--hl-* 与 .hl-mark[data-color] 同源）；当前色项以黑勾标记（#000 在 5 色上对比 ≥10:1）
#annotate-toolbar .at-color-opt[data-color=yellow]
  background-color var(--hl-yellow)
#annotate-toolbar .at-color-opt[data-color=green]
  background-color var(--hl-green)
#annotate-toolbar .at-color-opt[data-color=blue]
  background-color var(--hl-blue)
#annotate-toolbar .at-color-opt[data-color=pink]
  background-color var(--hl-pink)
#annotate-toolbar .at-color-opt[data-color=orange]
  background-color var(--hl-orange)
#annotate-toolbar .at-color-opt.active::after
  content ''
  position absolute
  left 50%
  top 50%
  width 6px
  height 10px
  border-right 2px solid #000
  border-bottom 2px solid #000
  transform translate(-50%, -55%) rotate(45deg)

// 复制反馈：.copied（约 1.2s 后由 JS 移除）→ 黄底 + 勾图标（参照工具箱 .copied 模式）
#annotate-toolbar .at-copy .i-check
  display none
#annotate-toolbar .at-copy.copied
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
  .i-check
    display block
  .i-copy
    display none

// 工具视觉态：分享成功 .copied（对勾，约 1.2s 后由 JS 移除）；收藏已存 .saved（星标实心 + 主题黄底板）
.bottom-btn .toolbox-share .i-check
  display none
.bottom-btn .toolbox-share.copied
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .toolbox-share.copied .i-share
  display none
.bottom-btn .toolbox-share.copied .i-check
  display block
.bottom-btn .toolbox-favorite.saved
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .toolbox-favorite.saved .i-star
  fill currentColor

// 正文标注高亮（JS 侧为选中文字包裹 .hl-mark）：与 ::selection 同源配色（默认主题黄 #fe2 底 + 黑字），深浅主题通用
// 5 色色板 --hl-* 同时供 .hl-mark[data-color] 与工具栏色板 / 当前色填充使用；黑字 #000 在全部色上对比 ≥10:1
:root
  --hl-yellow #fe2
  --hl-green #7ee787
  --hl-blue #79c0ff
  --hl-pink #ffb3d1
  --hl-orange #ffb757
.hl-mark
  background-color var(--theme-subcolor)
  color #000
  border-radius 2px
  padding 0 1px
.hl-mark[data-color=yellow]
  background-color var(--hl-yellow)
.hl-mark[data-color=green]
  background-color var(--hl-green)
.hl-mark[data-color=blue]
  background-color var(--hl-blue)
.hl-mark[data-color=pink]
  background-color var(--hl-pink)
.hl-mark[data-color=orange]
  background-color var(--hl-orange)

// 减少动效偏好：关闭本组全部过渡 / 动画（扇形展开、悬停抽出、图标旋转、目录条变形、工具栏淡入）
@media (prefers-reduced-motion: reduce)
  .bottom-btn a, .bottom-btn button, .bottom-btn .toolbox-item, .bottom-btn .i-icon, .bottom-btn .tocBtnIconBar, #annotate-toolbar, #annotate-toolbar .at-colors
    transition none