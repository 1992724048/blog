// 底部按钮组：右列单列 flex 栈（DOM 顺序即视觉顺序、数量可扩展，列内 gap 6px），工具箱独立锚定左下角；
// 两侧共用 --btn-inset 底部基线（8px）：工具箱 toggle 与 #color-mode 均为该基线内末位 40px 方框，底缘严格同行
.bottom-btn
  --btn-inset 8px
  position sticky
  bottom 0
  z-index 65536
  display flex
  flex-direction column
  align-items flex-end
  @media ( max-width 768px )
    position fixed
    left 0
    width 100vw
  .bottom-btn-stack
    position absolute
    right var(--btn-inset)
    bottom var(--btn-inset)
    display flex
    flex-direction column
    align-items flex-end
    gap 6px
  a, button
    position relative
    overflow hidden
    display flex
    align-items center
    justify-content center
    width 40px
    height 40px
    padding 0
    margin 0
    border 0
    border-radius 0
    background-color transparent
    color var(--theme-text-light)
    font-family inherit
    font-size 40px
    font-weight 900
    line-height 40px
    text-align center
    user-select none
    -webkit-tap-highlight-color transparent
    -webkit-appearance none
    appearance none
    transition background-color .2s, color .2s
    @media ( min-width 769px )
      &:hover
        background-color var(--theme-subcolor)
        color var(--theme-text-hover)
    &:active
      background-color var(--theme-subcolor)
      color var(--theme-text-hover)
    &:focus-visible
      outline 2px solid var(--theme-text-light)
      outline-offset 2px
.bottom-btn .i-top, .bottom-btn .i-back, .bottom-btn .i-color, .bottom-btn .toolbox-toggle, .bottom-btn .toolbox-item
  background-color var(--theme-bg-light)
  color var(--theme-text-rev)
.i-icon
  margin auto
  width 16px
  height 16px
  display block
  transition transform .3s
.bottom-btn .i-bgm-icon
  display block
  width 16px
  height 16px
  background-color currentColor
  -webkit-mask url('../icons/sound.svg') no-repeat center / contain
  mask url('../icons/sound.svg') no-repeat center / contain
.bottom-btn .toolbox-bgm[aria-pressed="true"]
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .i-color
  @media ( min-width 769px )
    &:hover .i-icon
      transform rotate(90deg)
.i-index
  .tocBtnIconBar
    background-color var(--theme-text-light)
    width 25px
    position absolute
    top 50%
    width 24px
    height 0.1em
    text-indent 101%
    white-space nowrap
    overflow hidden
    transition transform ease-in-out 0.3s
    left 8px
    &:nth-child(1)
      transform translate(0, -250%)
    &:nth-child(2)
      transform translate(0, -50%)
    &:nth-child(3)
      transform translate(0, 150%)
  &.open .tocBtnIconBar
    &:nth-child(1)
      transform translate(0, -50%) rotate(45deg) scaleX(1.2)
    &:nth-child(2)
      transform translate(0, -50%) translateX(-300%)
    &:nth-child(3)
      transform translate(0, -50%) rotate(-45deg) scaleX(1.2)

// 工具箱：.toolbox 根承载展开态类 .toolbox-open（点击 / 外点 / Escape 由 document 委托接线）
// 独立锚定 .bottom-btn 左下角，与右列共用 --btn-inset 底部基线（桌面 sticky / ≤768px fixed 同锚）；
// .toolbox 高度 = 唯一常规子项 .toolbox-toggle（40px），故 toggle 底缘 = 基线 = #color-mode 底缘
// 扇形几何：由 Toolbox.ts 的纯函数 layoutFan() 按「恒定角密度 + 半径随项数自适应」算出
// --fan-x / --fan-y / --pull-x / --pull-y（px 化）后逐项写入内联样式，CSS 只消费不再派生
// （象限 [0°,90°]、圆心距下限、半径公式与项数无关的旋钮全部下沉到 TS 侧）
.bottom-btn .toolbox
  position absolute
  // 视觉左间距 = 底部基线（8px）：补偿 .bottom-btn 所处 article 的左偏移（--toolbox-shift，各断点见下）
  left calc(var(--btn-inset) - var(--toolbox-shift, 0px))
  bottom var(--btn-inset)
  display flex
  flex-direction column
  align-items flex-start
  // 悬停抽出时的放大倍率：CSS hover 规则的 scale() 是唯一消费方
  --fan-scale 1.08

// --toolbox-shift = article 相对视口的左偏移（对应 flex_layout.styl 的 article margin-left）；≤768px 不补偿（.bottom-btn 为 fixed left:0，视觉已等距）
@media ( min-width 769px )
  .bottom-btn
    --toolbox-shift 20px
@media ( min-width 1024px )
  .bottom-btn
    --toolbox-shift 25px
@media ( min-width 1912px )
  .bottom-btn
    --toolbox-shift 2.5vw
.bottom-btn .toolbox-toggle
  z-index 3
.bottom-btn .toolbox-open .toolbox-toggle
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .toolbox-items
  position absolute
  top 0
  right 0
  z-index 2
.bottom-btn .toolbox-item
  // 兜底：脚本未执行或容器零项时贴回 toggle 位置（不散开）；正常运行期由 JS 内联样式覆写
  --fan-x 0px
  --fan-y 0px
  --pull-x 0px
  --pull-y 0px
  position absolute
  top 0
  right 0
  z-index 1
  opacity 0
  visibility hidden
  pointer-events none
  transform translate(0, 0)
  transition transform .24s cubic-bezier(.2, .8, .3, 1.1), opacity .18s ease-out, visibility 0s linear .24s, background-color .2s, color .2s, box-shadow .2s
// 展开态：轻微投影明确层级（深浅主题通用黑系阴影，克制）；悬停抽出态略强（见下）
// 位移直接消费 JS 写入的 px 值（--fan-x / --fan-y），hover 态再叠加同向的径向外抽量（--pull-x / --pull-y）
.bottom-btn .toolbox-open .toolbox-item
  opacity 1
  visibility visible
  pointer-events auto
  transition-delay 0s
  transform translate(var(--fan-x), var(--fan-y))
  box-shadow 0 2px 8px rgba(0, 0, 0, .25)
// 状态提示进入动画：纯 CSS，由 lease 既有的 hidden = false 写入天然触发
// （节点从 display:none 变为渲染态时该动画被创建；不新增任何属性 / 类切换面）
// 关键约束：静止态不得声明 opacity 0 —— 否则减动效 animation:none 会让提示永久不可见
@keyframes arknights-status-enter
  0%
    opacity 0
    transform translateX(calc(-1 * (100% + var(--status-slide-gap)))) scale(var(--status-scale))
  45%
    opacity 1
  100%
    opacity 1
    transform translateX(0) scale(1)
.bottom-btn .toolbox-status
  --status-slide-gap 12px
  --status-scale .96
  --status-enter-dur 260ms
  --status-enter-ease cubic-bezier(.22, 1, .36, 1)
  // 以下三项只被退场的 TS 侧镜像常量消费（CSS 不使用），保留是为了两侧数值同表可审
  --status-exit-dur 180ms
  --status-exit-ease cubic-bezier(.4, 0, 1, 1)
  --status-exit-fade .6
  position absolute
  left 0
  bottom calc(100% + 8px)
  z-index 4
  width max-content
  max-width unquote('min(40vw, 320px)')
  padding 6px 8px
  background-color var(--theme-bg-light)
  color var(--theme-text-rev)
  font-size 12px
  line-height 1.4
  white-space normal
  pointer-events none
  // 缩放轴心取锚定的左下角：进入时盒子贴住锚点向右生长，不会先右移再左移
  transform-origin 0 100%
.bottom-btn .toolbox-status:not([hidden])
  animation arknights-status-enter var(--status-enter-dur) var(--status-enter-ease) 1
.bottom-btn .toolbox-status[hidden]
  display none
@media ( min-width 769px )
  .bottom-btn .toolbox-open .toolbox-item:hover,
  .bottom-btn .toolbox-open .toolbox-item:focus-visible
    z-index 5
    box-shadow 0 4px 10px rgba(0, 0, 0, .35)
    transform translate(calc(var(--fan-x) + var(--pull-x)), calc(var(--fan-y) + var(--pull-y))) scale(var(--fan-scale))

// 工具视觉态：标注模式开启 .active（其余交互面见 annotate_toolbar.styl）；分享成功 .copied（对勾，约 1.2s 后由 JS 移除）；收藏已存 .saved（星标实心 + 主题黄底板）
.bottom-btn .toolbox-annotate.active
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .toolbox-share .i-check
  display none
.bottom-btn .toolbox-share.copied
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .toolbox-share.copied .i-share
  display none
.bottom-btn .toolbox-share.copied .i-check
  display block
.bottom-btn .toolbox-favorite.saved
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .toolbox-favorite.saved .i-star
  fill currentColor

// 减少动效偏好：关闭本组全部过渡 / 动画（扇形展开、悬停抽出、图标旋转、目录条变形、工具栏淡入、状态提示滑入）
// 横切块：选择器同时覆盖本文件的工具箱与 annotate_toolbar.styl 的标注工具栏，整块留在本文件末尾以保证覆盖顺序
// 状态提示必须带 :not([hidden]) 前缀：进入动画规则是 (0,3,0)，只写 .bottom-btn .toolbox-status 的 (0,2,0) 压不住它
@media (prefers-reduced-motion: reduce)
  .bottom-btn a, .bottom-btn button, .bottom-btn .toolbox-item, .bottom-btn .i-icon, .bottom-btn .tocBtnIconBar, .bottom-btn .toolbox-status:not([hidden]), #annotate-toolbar, #annotate-toolbar .at-colors
    transition none
    animation none