// 底部按钮组：右列单列 flex 栈（DOM 顺序即视觉顺序、数量可扩展，列内 gap 6px），工具箱独立锚定左下角；
// 两侧共用 --btn-inset 底部基线（8px）：工具箱 toggle 与 #color-mode 均为该基线内末位 40px 方框，底缘严格同行
.bottom-btn
  --btn-inset 8px
  position sticky
  bottom 0
  z-index 65536
  display flex
  flex-direction column
  align-items flex-end
  @media ( max-width 768px )
    position fixed
    left 0
    width 100vw
  .bottom-btn-stack
    position absolute
    right var(--btn-inset)
    bottom var(--btn-inset)
    display flex
    flex-direction column
    align-items flex-end
    gap 6px
  a, button
    position relative
    overflow hidden
    display flex
    align-items center
    justify-content center
    width 40px
    height 40px
    padding 0
    margin 0
    border 0
    border-radius 0
    background-color transparent
    color var(--theme-text-light)
    font-family inherit
    font-size 40px
    font-weight 900
    line-height 40px
    text-align center
    user-select none
    -webkit-tap-highlight-color transparent
    -webkit-appearance none
    appearance none
    transition background-color .2s, color .2s
    @media ( min-width 769px )
      &:hover
        background-color var(--theme-subcolor)
        color var(--theme-text-hover)
    &:active
      background-color var(--theme-subcolor)
      color var(--theme-text-hover)
    &:focus-visible
      outline 2px solid var(--theme-text-light)
      outline-offset 2px
.bottom-btn .i-top, .bottom-btn .i-back, .bottom-btn .i-color, .bottom-btn .toolbox-toggle, .bottom-btn .toolbox-item
  background-color var(--theme-bg-light)
  color var(--theme-text-rev)
.i-icon
  margin auto
  width 16px
  height 16px
  display block
  transition transform .3s
.bottom-btn .i-bgm-icon
  display block
  width 16px
  height 16px
  background-color currentColor
  -webkit-mask url('../icons/sound.svg') no-repeat center / contain
  mask url('../icons/sound.svg') no-repeat center / contain
.bottom-btn .toolbox-bgm[aria-pressed="true"]
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .i-color
  @media ( min-width 769px )
    &:hover .i-icon
      transform rotate(90deg)
.i-index
  .tocBtnIconBar
    background-color var(--theme-text-light)
    width 25px
    position absolute
    top 50%
    width 24px
    height 0.1em
    text-indent 101%
    white-space nowrap
    overflow hidden
    transition transform ease-in-out 0.3s
    left 8px
    &:nth-child(1)
      transform translate(0, -250%)
    &:nth-child(2)
      transform translate(0, -50%)
    &:nth-child(3)
      transform translate(0, 150%)
  &.open .tocBtnIconBar
    &:nth-child(1)
      transform translate(0, -50%) rotate(45deg) scaleX(1.2)
    &:nth-child(2)
      transform translate(0, -50%) translateX(-300%)
    &:nth-child(3)
      transform translate(0, -50%) rotate(-45deg) scaleX(1.2)

// 工具箱：.toolbox 根承载展开态类 .toolbox-open（点击 / 外点 / Escape 由 document 委托接线）
// 独立锚定 .bottom-btn 左下角，与右列共用 --btn-inset 底部基线（桌面 sticky / ≤768px fixed 同锚）；
// .toolbox 高度 = 唯一常规子项 .toolbox-toggle（40px），故 toggle 底缘 = 基线 = #color-mode 底缘
// 扇形几何：象限固定 0°（正右）→ 90°（正上），步长按 .toolbox-items 的实际项数均分 = --fan-span / (n − 1)；
// 项身份只由 [data-action] 的 --fan-ordinal 决定，:nth-of-type 仅用于数数量，不参与身份判定；
// --fan-slot 用 clamp 把 ordinal 压到 [0, n−1]，条件缺项造成 ordinal 不连续时不越出象限、不与其它项重合
.bottom-btn .toolbox
  position absolute
  // 视觉左间距 = 底部基线（8px）：补偿 .bottom-btn 所处 article 的左偏移（--toolbox-shift，各断点见下）
  left calc(var(--btn-inset) - var(--toolbox-shift, 0px))
  bottom var(--btn-inset)
  display flex
  flex-direction column
  align-items flex-start
  // 扇形旋钮（子项经 .toolbox-items 逐级继承）：角度区间 / 展开半径 / 悬停外抽量 / 悬停放大倍率
  --fan-span 90deg
  --fan-radius 66px
  --fan-pull 10px
  --fan-scale 1.08

// --toolbox-shift = article 相对视口的左偏移（对应 flex_layout.styl 的 article margin-left）；≤768px 不补偿（.bottom-btn 为 fixed left:0，视觉已等距）
@media ( min-width 769px )
  .bottom-btn
    --toolbox-shift 20px
@media ( min-width 1024px )
  .bottom-btn
    --toolbox-shift 25px
@media ( min-width 1912px )
  .bottom-btn
    --toolbox-shift 2.5vw
.bottom-btn .toolbox-toggle
  z-index 3
.bottom-btn .toolbox-open .toolbox-toggle
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .toolbox-items
  position absolute
  top 0
  right 0
  z-index 2
  // 项数感知：n ≤ 1 时取象限平分线（无项或单项不贴 toggle），n ≥ 2 走对应档位
  --fan-last 0
  --fan-origin calc(var(--fan-span) / 2)
  --fan-step 0deg
  // 档位必须按 n 升序书写，末条命中生效（累积式：新增第 6 项只需在末尾追加一条）
  &:has(> .toolbox-item:nth-of-type(2))
    --fan-last 1
    --fan-origin 0deg
    --fan-step var(--fan-span)
  &:has(> .toolbox-item:nth-of-type(3))
    --fan-last 2
    --fan-step calc(var(--fan-span) / 2)
  &:has(> .toolbox-item:nth-of-type(4))
    --fan-last 3
    --fan-step calc(var(--fan-span) / 3)
  &:has(> .toolbox-item:nth-of-type(5))
    --fan-last 4
    --fan-step calc(var(--fan-span) / 4)
.bottom-btn .toolbox-item
  --fan-ordinal 0
  --fan-slot clamp(var(--fan-ordinal), 0, var(--fan-last))
  --fan-angle calc(var(--fan-origin) + var(--fan-slot) * var(--fan-step))
  --fan-x calc(var(--fan-radius) * cos(var(--fan-angle)))
  --fan-y calc(-1 * var(--fan-radius) * sin(var(--fan-angle)))
  --pull-x calc(var(--fan-pull) * cos(var(--fan-angle)))
  --pull-y calc(-1 * var(--fan-pull) * sin(var(--fan-angle)))
  position absolute
  top 0
  right 0
  z-index 1
  opacity 0
  visibility hidden
  pointer-events none
  transform translate(0, 0)
  transition transform .24s cubic-bezier(.2, .8, .3, 1.1), opacity .18s ease-out, visibility 0s linear .24s, background-color .2s, color .2s, box-shadow .2s
// ordinal 映射：只声明序号，几何一律由上面推导（收紧到直接子级，避免命中 .toolbox 外的同名按钮）
.bottom-btn .toolbox-items > [data-action=annotate]
  --fan-ordinal 0
.bottom-btn .toolbox-items > [data-action=share]
  --fan-ordinal 1
.bottom-btn .toolbox-items > [data-action=favorite]
  --fan-ordinal 2
.bottom-btn .toolbox-items > [data-action=screenshot]
  --fan-ordinal 3
.bottom-btn .toolbox-items > [data-action=bgm]
  --fan-ordinal 4
// 展开态：轻微投影明确层级（深浅主题通用黑系阴影，克制）；悬停抽出态略强（见下）
.bottom-btn .toolbox-open .toolbox-item
  opacity 1
  visibility visible
  pointer-events auto
  transition-delay 0s
  transform translate(var(--fan-x), var(--fan-y))
  box-shadow 0 2px 8px rgba(0, 0, 0, .25)
.bottom-btn .toolbox-status
  position absolute
  left 0
  bottom calc(100% + 8px)
  z-index 4
  width max-content
  max-width unquote('min(40vw, 320px)')
  padding 6px 8px
  background-color var(--theme-bg-light)
  color var(--theme-text-rev)
  font-size 12px
  line-height 1.4
  white-space normal
  pointer-events none
.bottom-btn .toolbox-status[hidden]
  display none
@media ( min-width 769px )
  .bottom-btn .toolbox-open .toolbox-item:hover,
  .bottom-btn .toolbox-open .toolbox-item:focus-visible
    z-index 5
    box-shadow 0 4px 10px rgba(0, 0, 0, .35)
    transform translate(calc(var(--fan-x) + var(--pull-x)), calc(var(--fan-y) + var(--pull-y))) scale(var(--fan-scale))

// 工具视觉态：标注模式开启 .active（其余交互面见 annotate_toolbar.styl）；分享成功 .copied（对勾，约 1.2s 后由 JS 移除）；收藏已存 .saved（星标实心 + 主题黄底板）
.bottom-btn .toolbox-annotate.active
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .toolbox-share .i-check
  display none
.bottom-btn .toolbox-share.copied
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .toolbox-share.copied .i-share
  display none
.bottom-btn .toolbox-share.copied .i-check
  display block
.bottom-btn .toolbox-favorite.saved
  background-color var(--theme-subcolor)
  color var(--theme-text-hover)
.bottom-btn .toolbox-favorite.saved .i-star
  fill currentColor

// 减少动效偏好：关闭本组全部过渡 / 动画（扇形展开、悬停抽出、图标旋转、目录条变形、工具栏淡入）
// 横切块：选择器同时覆盖本文件的工具箱与 annotate_toolbar.styl 的标注工具栏，整块留在本文件末尾以保证覆盖顺序
@media (prefers-reduced-motion: reduce)
  .bottom-btn a, .bottom-btn button, .bottom-btn .toolbox-item, .bottom-btn .i-icon, .bottom-btn .tocBtnIconBar, #annotate-toolbar, #annotate-toolbar .at-colors
    transition none