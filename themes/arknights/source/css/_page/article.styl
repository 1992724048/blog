article
  transition margin .3s
  box-sizing border-box
  position relative
  min-height calc(100vh - 10px)
  height fit-content
  min-width 1px
  #post-content p
    line-height 150%

.posts
  margin-top 10px
  padding-bottom 72px
  width 100%
  min-height calc(100vh - 82px)

.recent-post
  background-color var(--theme-bg-trans1)
  color var(--theme-unimportant)
  display block
  margin-bottom -1px
  border 1px solid var(--theme-unimportant)
  padding 13px 15px
  transition .3s
  .recent-info::after
    transition .3s
  .categories, .tags
    font-family BenderLight, sans-serif
  .categories
    color var(--theme-highlight)
    font-size large
    font-weight bold
    padding 0 10px 0 0
  .tags
    font-size small
    span
      display inline-block
      padding 0 5px 0 0
  time
    color var(--theme-unimportant)
    display inline-block
    text-align left
    float right
  .post-meta
    color var(--theme-unimportant)
    font-family Bender
    display inline-block
    text-align left
    float right
    time
      float none
  hr
    color var(--theme-unimportant)
    border-color var(--theme-unimportant)
  img
    width 100%
  h1
    font-family sans-serif
    color var(--theme-text-light)
    margin 0
    padding 15px 0 0 0
  @media ( min-width 769px )
    &:hover
      color var(--theme-text-hover)
      background-color var(--theme-highlight)
      time, .categories, .post-meta
        color var(--theme-text-hover)
      a, a:active
        color var(--theme-text-rev)
      .recent-info::after
        background-color var(--theme-bg-hover)
      //- 摘要文本级颜色不随卡片底色继承：悬停时底色变主题蓝，须显式切到近黑（明暗两套均为 #000）
      .list-excerpt
        color var(--theme-text-hover)
      a:hover
        color var(--theme-text-light)
      hr
        color var(--theme-highlight)
        border-color var(--theme-highlight)
      figure table
        .gutter
          background-color var(--theme-border)
        .code
          background-color var(--theme-bg-trans1)
          &, &:hover
            color var(--theme-text-light)
      blockquote:not(.alert)
        &, &:hover
          color var(--theme-text-light)
          border-color var(--theme-border)
          background-color var(--theme-bg-trans1)
      .read-more
        color var(--theme-text-light)
        background-color var(--theme-bg-hover)
      .post-sticky
        color var(--theme-text-light)
        background-color var(--theme-bg-hover)
        transition .3s

.recent-info
  min-height 25px
  &:after
    content ''
    width 13%
    display block
    height 5px
    background-color var(--theme-highlight)
    position relative
    bottom -6px

// 列表页摘要的共享视觉契约：行内摘要（首页 / 分类 / 标签）与归档页悬停弹窗共用同一套文本排版
// 数据源是 frontmatter 的 description（纯文本，非 marked 产物），故只需文本级样式；
// 与标题的间距 / 缩进等几何由各容器上下文另行给出。
// 字号取 16px，与 aside footer 的「使用主题」一行同为 body 继承值（即 medium 绝对字号关键字），
// 但摘要显式声明 font-weight normal，故不随该行的 Bender + bold 一同加粗。
// 颜色取 --theme-text（明 #222 / 暗 #c4c4c4，对两套底色均 >10:1，满足 WCAG AA 正文门槛），
// 不取容器继承的 --theme-unimportant（#767676 对浅色底仅 4.16:1，未达 4.5:1）。
.list-excerpt, .excerpt-popup
  color var(--theme-text)
  font-size 16px
  font-weight normal
  line-height 150%

// 首页卡片：摘要夹在标题与「阅读文章 +」之间，下边距让开负外边距的按钮
.recent-post .list-excerpt
  margin 12px 0 28px 0

.post-sticky
  background-color var(--theme-highlight)
  color var(--theme-text-rev)
  padding 1px 2px
  margin-right 5px
  transition .3s

.read-more
  color var(--theme-background)
  display block
  float right
  font-size smaller
  font-weight 600
  background-color var(--theme-highlight)
  margin-top -21px
  padding 3px 10px 3px 40px
  font-family BenderLight

// 悬停「阅读文章 +」自身：黄底黑字（与 .recent-post:hover .read-more 同特异性且源码在后，层叠胜出）
@media ( min-width 769px )
  .recent-post .read-more:hover
    color #000
    background-color var(--theme-subcolor)

#paginator
  width 100%
  user-select none
  margin 20px 0
  display flex
  flex-wrap wrap
  justify-content center
  position absolute
  bottom 0
  left 0
  a, span
    color var(--theme-text-light)
    font-weight bold
    margin 0 10px 0 0
    border 1px solid var(--theme-highlight)
    padding 5px 10px
    &:last-child
      margin 0
  @media ( min-width 769px )
    a:hover
      color var(--theme-text-hover)
      background-color var(--theme-highlight)
  .current
    color var(--theme-text-hover)
    background-color var(--theme-highlight)
