#archive-flex
  width 100%
  height fit-content
  min-height 600px
  box-sizing border-box
  display flex
  justify-content stretch
  position: relative

#archive-aside
  &::-webkit-scrollbar
    display none
  &::-ms-scrollbar
    display none
  scrollbar-width none
  padding-bottom 30px
  overflow auto
  box-sizing border-box
  padding-top 10px
  top 0
  height fit-content
  @media ( min-width 769px )
    max-height 100vh
  display flex
  flex-grow 1
  flex-direction column

#Archives, #Categories, #Tags
  margin 0 10px
  background-color var(--theme-bg-trans1)
  overflow-y auto
  &, h1
    transition .3s
  h1
    margin 0
    padding 0 15px
    color var(--theme-text-rev)
    background-color var(--theme-bg-light)
    font-size medium
    font-family BenderLight
  @media ( min-width 769px )
    &:hover, &:target
      background-color var(--theme-bg-trans2)
      h1
        background-color var(--theme-highlight)

#Archives
  margin-bottom 30px
  margin-top 10px
  @media ( min-width 769px )
    min-height calc(100vh - 40px)
  flex-grow 5
  position relative
  h2
    margin 10px 0
    font-size large
    &:before
      content ''
      display inline-block
      width 5px
      height 15px
      margin-right 5px
      background-color var(--theme-subcolor)
  time
    color var(--theme-text-light)
.categories, .tags
  display inline-block
#Archives-bg
  box-sizing border-box
  padding 10px
  padding-bottom 60px
  // 列表条目几何的两个共用尺度在此立为 token：条目水平内边距与日期列宽。
  // 二者共同决定标题链接的左缘（内边距 + 日期列宽）与左右边界，弹窗的等宽定位
  // 也复用同一组值，故「弹窗与链接等宽」是结构性的而非靠算式维护的。
  // 本文件中 .control-archive / .article-item .list-excerpt / .excerpt-popup 三个选择器
  // 均只在 #Archives-bg 内使用，故不设 var() 回退值。
  --list-item-pad-x 20px
  --list-date-w 55px

.article-item
  padding-inline var(--list-item-pad-x)
  display flex
  // 摘要（.list-excerpt）宽度 100% 故自动换行到标题下方；无 wrap 时它会被压在同一行右侧
  flex-wrap wrap
  // 日期（time 用 Bender）与标题（正文字体栈）字体不同，line-height: normal 下两者的
  // 行盒高度与基线偏移都按各自字体度量算出，stretch 会让两段文字基线错开；
  // baseline 对齐按各自首条基线就位，与具体字体度量无关，故在任何平台都恰好齐平（0.000px）。
  // 前提是日期与标题同处一条 flex 线——该前提由下方 .control-archive / .control-archive + a
  // 的 border-box 契约保证；标题文本自身在窄视口下折行时按首条基线就位，结论仍成立。
  // 摘要占位的那条 flex 线上只有一个元素，基线对齐退化为不拉伸，位置与原先 stretch 一致。
  align-items baseline
  position relative
  margin-bottom 15px
  &::after
    content ''
    // 绝对定位元素的包含块是本元素的 padding box（本元素无 border），故 left / right
    // 与内容盒的 padding-inline 边距同基准：两端解出、不声明 width，分隔线两端与内容
    // 盒齐平。条目内边距已提为 --list-item-pad-x，此处若再写死 15px / 30px 字面量，
    // 20px 内边距下两端各会比内容多伸出 5px。
    position absolute
    display block
    bottom -5px
    left var(--list-item-pad-x)
    right var(--list-item-pad-x)
    border-bottom: 1px var(--theme-unimportant-trans) solid
  // 摘要左缘与标题对齐（复用日期列宽），使其视觉上从属于标题而非日期
  .list-excerpt
    box-sizing border-box
    width 100%
    margin-top 6px
    padding-left var(--list-date-w)

#Categories
  height fit-content
  overflow visible
  height 50%
  flex-grow 1
  margin-bottom 20px
  p
    text-align center

#Tags
  height fit-content
  overflow visible
  height 100%
  flex-grow 1
  p
    text-align center

// 条目是一行 flex：日期列占 --list-date-w 固定宽、标题链接占满余下宽度。
// 全站没有 * { box-sizing: border-box } 重置（box-sizing 不继承），而 a 在 base.styl
// 带 padding 0 3px（左右各 3px、合计 6px），故按 content-box 计算时两项外宽合计
// 55 + (C - 55 + 6) = C + 6 > C（溢出恒为 6px，与视口宽度和标题长度都无关）。
// flex-wrap 的断行判定发生在 flex-shrink 之前、只看 flex base size，于是日期与标题
// 被拆到两条 flex 线：同一条线只剩一个元素，align-items baseline 形同虚设，
// 弹窗的 left 也整体错位。日期列与标题都显式声明 border-box，使各自 width 含自身
// 内边距，两项外宽合计恰为 C。
// 不采用「把标题宽度再减 6px」补魔数，也不采用 flex-basis 0 的填充写法：
// 后者 flex base 为 0 会让同为 flex item 的 width 100% 摘要（分类 / 标签页的行内态）
// 在断行判定中「放得下」而挤进标题那一行，把标题压成 0 宽；且其 flex base 随标题
// 文本长度变化，长标题仍会断行。本写法的 flex base 是确定长度，长标题只在盒内折行。
.control-archive
  box-sizing border-box
  // 日期列是固定宽列：基准取自身 width 且不可伸缩，故任何情况下都恰为 --list-date-w
  flex none
  width var(--list-date-w)
  display inline-block
  & + a
    box-sizing border-box
    width calc(100% - var(--list-date-w))

// 归档页条目摘要的悬停弹窗。基础块即「行内摘要」形态（静态定位、随条目占位），
// 供无 hover 能力的设备（触屏等）直接读到摘要；具备 hover 能力时由下面的
// @media ( hover: hover ) 块改造成浮层。
// 同一份 DOM 在两种形态间切换，故不渲染两份摘要，可访问性树里也只出现一次。
.excerpt-popup
  box-sizing border-box
  width 100%
  margin-top 6px
  padding-left var(--list-date-w)
  text-align left
  white-space normal

@media ( hover: hover )
  .excerpt-popup
    position absolute
    // 包含块是 .article-item 的 padding box（该元素 position: relative 且只 padding-inline，
    // 故其宽即条目外宽 W）。left 取「条目内边距 + 日期列宽」= 标题链接左缘，
    // right 取「条目内边距」= 标题链接右缘；width 不声明、由两端解出，
    // 于是弹窗盒与标题链接盒逐字等宽等位，无需维护任何算式。
    left calc(var(--list-item-pad-x) + var(--list-date-w))
    right var(--list-item-pad-x)
    // +6px 恰落在本条目分隔线（bottom -5px + 1px 边）的下沿，不压线
    top calc(100% + 6px)
    width auto
    margin-top 0
    padding 8px 10px
    z-index 30
    // 显隐走 visibility + opacity：visibility hidden 同时把摘要移出可访问性树，
    // 故仅在弹窗真正可见（即标题链接获焦或被悬停）时才被读出，无需 aria-describedby
    visibility hidden
    opacity 0
    transform translateY(4px)
    transform-origin top left
    transition opacity 160ms, transform 160ms, visibility 0s linear 160ms
    // 视觉沿用 AI 徽标提示浮层（.ai-badge__tip）：跟随主题的半透明底 + 轻度毛玻璃
    // + 轻投影，不设边框 / 圆角 / 箭头，保持同一套浮层语言
    background-color var(--theme-bg-trans1)
    -webkit-backdrop-filter blur(1px)
    backdrop-filter blur(1px)
    box-shadow 0 4px 12px rgba(0, 0, 0, .05)
  // 触发点是日期列之后那个标题链接（.control-archive + a 与既有链接规则同一写法），
  // 不把整个条目设为触发区，避免指针扫过日期列时误弹
  .control-archive + a:hover + .excerpt-popup,
  .control-archive + a:focus-within + .excerpt-popup
    visibility visible
    opacity 1
    transform translateY(0)
    transition-delay 0s

@media ( hover: hover ) and ( prefers-reduced-motion: reduce )
  .excerpt-popup
    transition none
    transform none
