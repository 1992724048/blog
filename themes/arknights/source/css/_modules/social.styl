// 顶栏社交图标（源 theme.social，模板见 layout/includes/header.pug）
// 右簇 = [.topbar-social][#search-header]：容器接管 margin-left auto，与搜索框保持固定小间距
.topbar-social
  display flex
  align-items center
  margin-left auto
  margin-right 8px

  a
    display flex
    align-items center
    justify-content center
    box-sizing border-box
    // 与顶栏内容区等高（36px 栏总高 − 1px 底边）：36px 会在 35px 内容区上下溢出
    width 35px
    height 35px
    color var(--theme-text-light)
    font-size 17px
    text-shadow none
    transition background-color .3s, color .3s

    &:hover,
    &:active
      background-color var(--theme-highlight)
      color var(--theme-text-hover)

    img
      height 1em

// ≥1024：右簇右锚改由 ol.navContent margin-right auto 承担（社交块被拦截隐藏时依然右贴）；
// 社交自身 margin-left 归零，保证全断点恰有一条 auto 链、无双 auto 分摊
@media ( min-width 1024px )
  .topbar-social
    margin-left 0
// ≤1023：navContent / search-header 均为下拉 / 常驻特殊位，nav 内仅社交入流，自身 auto 右贴搜索按钮左侧（维持现状）
