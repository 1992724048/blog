#search-input
  position relative
  box-sizing border-box
  width 100%
  padding 0
  color var(--theme-text-light)
  font-size 14px
  background-color unset
  border unset

#search-input::placeholder
  color #5c5c5c
  transition color .3s

// 深色底上 #5c5c5c 对比度不足 4.5:1，改用 --theme-unimportant
:root[theme-mode=dark] #search-input::placeholder
  color var(--theme-unimportant)

// 移动端：顶栏下整行输入（点击搜索图标展开，自动聚焦）
@media ( max-width 1023px )
  #search-header
    position absolute
    top 100%
    left 0
    right 0
    z-index 10
    box-sizing border-box
    height var(--search-row-h)
    display flex
    align-items center
    padding 0 16px
    background-color var(--theme-bg-trans0)
    border-top 1px solid var(--theme-border-soft)
    visibility hidden
    opacity 0
    transform translateY(-6px)
    transition opacity .2s, transform .2s, visibility 0s .2s
  header.search-open #search-header
    visibility visible
    opacity 1
    transform none
    transition opacity .2s, transform .2s
  #search-header .navItemTitle
    display block
    width 100%
  #search-header input
    height 40px

// 桌面端：右侧常驻搜索框
@media ( min-width 1024px )
  #search-header
    display flex
    align-items center
    margin-left auto
    width 220px
    height 36px
    box-sizing border-box
    border 1px solid var(--theme-border-soft)
    background-color var(--theme-bg-soft)
    transition border-color .3s, background-color .3s
    &:focus-within
      border-color var(--theme-highlight)
      background-color var(--theme-bg-soft-hover)
  #search-header .navItemTitle
    display block
    width 100%
  #search-header input
    height 100%
    padding 0 12px

// 搜索结果弹层：桌面锚定顶栏下方右对齐（top=56 / right=24 / width=min(480px, 100vw-48px)）；移动端全宽
.search-popup
  position absolute
  top 100%
  right 24px
  z-index 20
  width 480px
  max-width calc(100vw - 48px)
  height calc(100vh - var(--topbar-h))
  box-sizing border-box
  overflow-y auto
  overflow-wrap anywhere
  scrollbar-width thin
  background-color var(--theme-bg-trans0)
  border 1px solid var(--theme-border-soft)
  opacity 0
  visibility hidden
  transform translateY(-6px)
  transition opacity .2s, transform .2s, visibility 0s .2s
  &.open
    opacity 1
    visibility visible
    transform none
    transition opacity .2s, transform .2s

// 移动端：搜索行之下的全宽下拉
@media ( max-width 1023px )
  .search-popup
    top calc(100% + var(--search-row-h))
    right 0
    left 0
    width auto
    height calc(100vh - var(--topbar-h) - var(--search-row-h))

#loading
  font-family 'JetBrains Mono'
  display flex
  justify-content center
  div
    display inline-block
  p
    animation 2s loading infinite steps(4,jump-none)
    overflow-wrap normal
    overflow hidden
    display table-caption

@keyframes loading
  0%
    width calc(100% - 1.5em)
  100%
    width 100%

#search-result
  width 100%
  .recent-post
    font-family 'JetBrains Mono'
    margin 0
    padding 8px
    border none
    border-top 1px solid var(--theme-border-soft)
    border-bottom 1px solid var(--theme-border-soft)
    p
      margin .5em
      max-height 40px
      white-space initial
      overflow hidden
    b
      color var(--theme-text-light)
    &:hover .search-keyword
      color var(--theme-subcolor)
      transition .3s
      background-color unset
    overflow hidden
    .search-keyword
      background-color var(--theme-highlight)
      color var(--theme-text-light)
    .search-result-title
      font-size 1.1em
#no-result p
  text-align center

@media ( min-width 1024px )
  .blur
    article,
    aside,
    #canvas-dust
      filter blur(0.8px)
