#search-input
  position relative
  box-sizing border-box
  width 100%
  padding 0
  // 搜索框固定白底黑字（深浅色主题一致；桌面为 #search-header 白框内输入，≤1023 为栏下搜索行内输入）
  color #000
  // 覆盖 _core/base.styl 全局 input 的等宽字体，与 _custom/custom.styl 正文栈一致
  font-family 'HarmonyOS Sans SC', 'Microsoft YaHei', 'PingFang SC', sans-serif
  font-size 15px
  background-color #fff
  border unset

// 白底上的可读灰（对 #fff 对比度约 6.7:1），深浅色主题统一
#search-input::placeholder
  color #5c5c5c

// 搜索框内放大镜图标（内联 SVG，见 header.pug）：桌面常驻搜索框专用，移动端栏下搜索行不显示
#search-header .searchFieldIcon
  display none

// 整行 / 整框可点击聚焦输入框（含放大镜区域），以文本光标提示可输入
#search-header
  cursor text

// 移动端：顶栏下整行输入（点击搜索图标展开，自动聚焦）
@media ( max-width 1023px )
  #search-header
    position absolute
    top 100%
    left 0
    right 0
    z-index 10
    box-sizing border-box
    height var(--search-row-h)
    display flex
    align-items center
    padding 0 16px
    background-color var(--theme-bg-trans0)
    border-top 1px solid var(--theme-border-soft)
    visibility hidden
    opacity 0
    transform translateY(-6px)
    transition opacity .2s, transform .2s, visibility 0s .2s
  header.search-open #search-header
    visibility visible
    opacity 1
    transform none
    transition opacity .2s, transform .2s
  #search-header .navItemTitle
    display block
    width 100%
  #search-header input
    // 行总高 37px（36 + 1px 上边框）→ 内容区 36px：输入框缩为 34px，上下各留 1px
    display block
    height calc(var(--search-row-h) - 3px)
  // 白底输入框上深色主题的白色焦点环不可见，改用固定深色环（几何沿用 header.styl）
  #search-input:focus-visible
    outline-color #000

// 桌面端：右侧常驻搜索框
@media ( min-width 1024px )
  #search-header
    display flex
    align-items center
    width 220px
    // 按压顶栏内容区（36px 栏 − 1px 底边线 = 35px）满高布局：上缘贴顶、下缘与底边线相接；
    // 盒子不再覆盖底线（无需透明边框 / background-clip 机制），底线全段单线连续
    height calc(var(--topbar-h) - 1px)
    align-self flex-end
    box-sizing border-box
    // 无任何边框 / 轮廓（含焦点态）：白底直接铺满内容区，消除透明边框条造成的上 / 侧白缝
    border none
    background-color #fff
  // 无社交图标（.topbar-social 缺失）时搜索框自身贴右；有社交图标时由 .topbar-social 接管自动边距
  .navContent + #search-header
    margin-left auto
  #search-header .navItemTitle
    flex 1
    min-width 0
  #search-header input
    height 100%
    // 输入文字距左侧放大镜图标 5px（原为 0：紧贴蓝段）
    padding 0 10px 0 5px
  // 框内放大镜图标区：蓝底 + 白图标（--theme-highlight #2bf 两主题同色；白图标对此蓝底对比约 2.2:1，属已知取舍）
  // 满内容区高（35px，上缘贴顶 / 下缘接底线）：蓝段上下无白边、无夹层；padding 沿用原数值，图标视觉尺寸不变
  #search-header .searchFieldIcon
    display block
    flex none
    box-sizing border-box
    width 34px
    height 100%
    padding 9px 8px 9px 10px
    color #fff
    background-color var(--theme-highlight)
    pointer-events none
  // 桌面端输入框不描焦点环（整框与输入框均无边框 / 轮廓）；≤1023px 仍保留输入框内缩环
  #search-input:focus-visible
    outline none

// 搜索结果弹层：桌面锚定顶栏下方右对齐（right=0，右缘与搜索框 / 视口右缘对齐；宽 480px 上限 + max-width 100vw）；移动端全宽
.search-popup
  position absolute
  top 100%
  right 0
  z-index 20
  width 480px
  max-width 100vw
  height calc(100vh - var(--topbar-h))
  box-sizing border-box
  overflow-y auto
  overflow-wrap anywhere
  scrollbar-width thin
  background-color var(--theme-bg-trans0)
  border 1px solid var(--theme-border-soft)
  opacity 0
  visibility hidden
  transform translateY(-6px)
  transition opacity .2s, transform .2s, visibility 0s .2s
  &.open
    opacity 1
    visibility visible
    transform none
    transition opacity .2s, transform .2s

// 移动端：搜索行之下的全宽下拉
@media ( max-width 1023px )
  .search-popup
    top calc(100% + var(--search-row-h))
    right 0
    left 0
    width auto
    height calc(100vh - var(--topbar-h) - var(--search-row-h))

#loading
  font-family 'JetBrains Mono'
  display flex
  justify-content center
  div
    display inline-block
  p
    animation 2s loading infinite steps(4,jump-none)
    overflow-wrap normal
    overflow hidden
    display table-caption

@keyframes loading
  0%
    width calc(100% - 1.5em)
  100%
    width 100%

#search-result
  width 100%
  .recent-post
    font-family 'JetBrains Mono'
    margin 0
    padding 8px
    border none
    border-top 1px solid var(--theme-border-soft)
    border-bottom 1px solid var(--theme-border-soft)
    p
      margin .5em
      max-height 40px
      white-space initial
      overflow hidden
    b
      color var(--theme-text-light)
    &:hover .search-keyword
      color var(--theme-subcolor)
      transition .3s
      background-color unset
    overflow hidden
    .search-keyword
      background-color var(--theme-highlight)
      color var(--theme-text-light)
    .search-result-title
      font-size 1.1em
#no-result p
  text-align center

@media ( min-width 1024px )
  .blur
    article,
    aside,
    #canvas-dust
      filter blur(0.8px)
