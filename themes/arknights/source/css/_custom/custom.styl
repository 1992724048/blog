// 站点自定义样式：鸿蒙字体经 jsDelivr 分包 CDN 加载（Regular.css / Bold.css，链接见 meta-data.pug）

// 正文使用鸿蒙字体（代码块仍保留等宽字体）
body, html
  font-family 'HarmonyOS Sans SC', 'Microsoft YaHei', 'PingFang SC', sans-serif !important

// 代码字体：JetBrains Mono，中文回退到鸿蒙字体
code, pre, kbd, samp, .hljs, .code, .gutter pre
  font-family 'JetBrains Mono', 'HarmonyOS Sans SC', monospace !important

// 头像：顶部留白（内联 style 优先级高，需 !important）
#logo img
  margin-top 5px !important

// 文本选中：主题黄底黑字（全局生效：正文 / 代码块 / 顶栏等；两主题 --theme-subcolor 均为 #fe2）
::selection
  color #000
  background-color var(--theme-subcolor)

// 「??内容??」遮盖（filters/spoiler.js 产出 span.spoiler）：默认色块完全遮住文字，悬停显示
// --theme-bg-light 浅色主题 #000 / 深色主题 #fff（两主题均为高对比实心块）；触摸 / 键盘无 hover 属已知限制
.spoiler
  color transparent
  background-color var(--theme-bg-light)
  transition color .2s, background-color .2s
  &:hover
    color inherit
    background-color transparent

// 清除全局 a:hover / a:active 命中本锚点的蓝 / 黄底色（来源：_core/base.styl 的 a 悬停规则）：logo 悬停只允许角标
#logo:hover, #logo:focus, #logo:focus-visible, #logo:active
  background-color transparent

// 头像悬停角标：图片外侧的左下 / 右上两枚取景框式短角线（≥769px；≤768px 时 logo 图片被固定到视口外）
// 覆盖层与 1:1 图片逐像素重合（top 5px 对齐上方 img 的 margin-top，width 100% + aspect-ratio 1），
// 再经 transform 沿对角向外错开 5px，角线完全落在图片外的背景区（未压图片；aside 水平内边距 20px 足够容纳）
// 颜色取 --theme-text-light（浅色主题黑 / 深色主题白），在主题壁纸底上保持最大对比
@media ( min-width 769px )
  #logo
    position relative
    &::before, &::after
      content ''
      position absolute
      top 5px
      left 0
      width 100%
      aspect-ratio 1
      pointer-events none
      opacity 0
      transition opacity .3s
      background-repeat no-repeat
    // 左下角标：L 绘于覆盖层左下角，整层向左下错开 → 角线位于图片左下角外侧
    &::before
      transform translate(-5px, 5px)
      background-image linear-gradient(var(--theme-text-light), var(--theme-text-light)), linear-gradient(var(--theme-text-light), var(--theme-text-light))
      background-position left bottom, left bottom
      background-size 14px 2px, 2px 14px
    // 右上角标：L 绘于覆盖层右上角，整层向右上错开 → 角线位于图片右上角外侧
    &::after
      transform translate(5px, -5px)
      background-image linear-gradient(var(--theme-text-light), var(--theme-text-light)), linear-gradient(var(--theme-text-light), var(--theme-text-light))
      background-position right top, right top
      background-size 14px 2px, 2px 14px
  #logo:hover::before, #logo:hover::after,
  #logo:focus-visible::before, #logo:focus-visible::after
    opacity 1

// 减少动效偏好：关闭本次新增的过渡（沿用主题既有 reduced-motion 做法）
@media (prefers-reduced-motion: reduce)
  #logo::before, #logo::after, .spoiler
    transition none
