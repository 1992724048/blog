@media ( max-width 768px )
  main
    padding 0 12px
  main header
    // 顶栏全宽贴边：抵消 main 的 12px 内边距
    width calc(100% + 24px)
    margin 0 -12px
  article
    border none
    width 100%
    max-height none
    #post-bg
      padding 10px 10px 0 10px
  .highlight, blockquote
    margin 1em 0
  aside
    position static
    width 100%
    height auto
    padding 0
    h1
      font-size xx-large
      text-align center
      margin 0
    footer
      text-align center
      padding 10px 0
      position static
  #toc-div
    z-index 65534
    display flex
    flex-direction column
    position fixed
    top 0
    left 20vw
    transform translateX(100vw)
    background var(--theme-bg-trans0)
    transition .6s
    height 100vh
    width 80vw
    .toc
      margin-block auto
    &.open
      transform translateX(0)
  #paginator
    margin 20px 0 0 0
    a, span
      margin 5px 5px 0 0
  #post-index
    margin 0
  #logo
    height 0
    margin 0
    img
      opacity .05
      position fixed
      bottom -50px
      left -46%
      pointer-events none
  #total
    text-align center
    margin 0
    .total-title
      font-size medium
  #total-archives
    width auto
    .total-title
      display inline-block
  #post-index
    margin 16px 10px 0 10px
  #archive-flex
    flex-direction column
  #archive-aside
    order 1
  #Categories
    margin 10px
  #cursor-container
    display none
  #Archives
    margin 0
    time
      color var(--theme-text-light)
      padding 0
    .control
      width 55px
@media ( min-width 769px )
  main
    display flex
    flex-wrap wrap
    justify-content space-between
  // 顶栏独占首行，article / aside 排布在下方
  main header
    flex 0 0 100%
  // aside 为 content-box：列的实占宽度 = width + 40px 水平内边距；
  // article 的宽度预留包含该 40px 与列间距，否则 flex-wrap 会把 aside 折到下一行
  article
    margin-left 20px
    width calc(100% - 210px - 20px)
  #total-archives .total-number
    font-size 34px
  #to-index
    display none
  aside
    top var(--topbar-h)
    height calc(100vh - var(--topbar-h))
    width 170px
    h1
      font-size xx-large
    img
      transition background-color 1s
      &:hover
        background-color var(--theme-bg-soft-hover)
  #description p
    font-size small
  #archive-aside
    position sticky
    max-width 36%

@media ( min-width 1024px )
  article
    margin-left 25px
    width calc(100% - 230px - 25px)
  aside
    width 190px
    h1
      font-size 45px
  #total-archives .total-number
    font-size 40px
  #description p
    font-size medium

@media ( min-width 1440px )
  article
    margin-left 25px
    width calc(100% - 280px - 25px)
  aside
    width 230px
    h1
      font-size 50px
  #total-archives
    .total-title
      font-size 32px
    .total-number
      font-size 48px
  #total-tags, #total-categories
    font-size 23px
  .recent-post img
    width 90%
    margin 0 auto
    display block
    position relative
@media ( min-width 1912px )
  // 与 aside 的 2.5% 边距对称：左侧留出同宽空间
  article
    margin-left 2.5%
    width calc(100% - 310px - 7.5%)
  aside
    width 270px
    h1
      font-size 55px
  #total-archives .total-title
    font-size 37px
  #total-tags, #total-categories
    font-size 28px
  .search-pop-overlay .popup
    left 65%
  .recent-post img
    width 80%
