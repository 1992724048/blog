// ===== 顶栏响应式布局
// ≤1023px：☰ / 搜索图标按钮 + 顶栏下全宽下拉（菜单 / 搜索行）
@media ( max-width 1023px )
  .navBtn, .searchBtn
    display flex

  ol.navContent
    position absolute
    top 100%
    left 0
    right 0
    z-index 10
    box-sizing border-box
    max-height calc(100vh - var(--topbar-h))
    overflow-y auto
    flex-direction column
    align-items stretch
    background-color var(--theme-bg-trans0)
    visibility hidden
    opacity 0
    transform translateY(-6px)
    transition opacity .2s, transform .2s, visibility 0s .2s

  header.nav-open ol.navContent
    visibility visible
    opacity 1
    transform none
    transition opacity .2s, transform .2s

  .navContent > .navItem
    width 100%
    border-top 1px solid var(--theme-border-soft)
    &:first-child
      border-top unset

  .navContent > .navItem > :is(.navBlock, .navSecond)
    display flex
    align-items center
    flex-wrap wrap
    box-sizing border-box
    min-width 0
    justify-content flex-start
    min-height 48px
    padding 10px 20px

  .navContent .navItemTitle
    flex 1
    font-size 15px

  // 移动端 active 名称继续与图标成组（6px 间距）；桌面固定宽度下由 header.styl 归零居中
  // 选择器带 ol.navContent 前缀：特异性高于 header.styl 的同名规则（该文件编译序在后）
  ol.navContent .navItem.active > .navBlock .navItemLabel
    margin-left 6px

// ≥1024px：导航平铺 + 右侧常驻搜索框；☰ / 搜索图标按钮隐藏
@media ( min-width 1024px )
  // 选择器带 main 前缀：保证特异性高于 header.styl 的基础内边距（导入顺序在后）
  // 右侧内边距 0：右侧簇（社交图标 + 搜索框）紧贴视口右缘，无空白
  main header
    padding 0 0 0 24px

  .navBtn, .searchBtn
    display none

  ol.navContent
    height 100%

  .navContent > .navItem
    height 100%

  // 一级导航为自适应宽度（border-box，高度 36px 与顶栏 36px 外高一致）：宽度随内容走，
  // 图标项与文字项用同一组左右内边距取得一致的横向留白；宽度不再固定，故 active 项收起图标 /
  // 展开名称时按钮宽度随内容变化，后续按钮与右侧簇随之移动
  .navContent > .navItem > :is(.navBlock, .navSecond)
    box-sizing border-box
    width auto
    min-width 0
    height 36px
    display flex
    align-items center
    justify-content center
    padding 0 12px

  // 标题占满按钮可用宽度并水平居中：名称的展开 / 收起不改变图标与名称的相对位置
  .navContent > .navItem > :is(.navBlock, .navSecond) > .navItemTitle
    flex 1
    justify-content center

  // 底部凸出指示（仅桌面平铺态）：伪元素绝对定位、不参与布局，因此不改动按钮几何、
  // 不改动 nav 的对齐，也不加剧既有 1px 下沿溢出。锚点是 .navBlock 的 padding box 下沿
  // （y = 36 − 2.5 = 33.5，.navBlock 的 position: relative 定位上下文）；向下让出既有
  // 2.5px 底边后，伪元素总高 = 顶栏底边厚度 + 凸出量，故顶边恒为 y 35（顶栏外缘 y 36 的上沿），
  // 与既有蓝条在最后一像素带重叠 → 无接缝；下沿 y 36 + 凸出量。
  .navContent > .navItem > :is(.navBlock, .navSecond)::after
    content ''
    position absolute
    left 0
    right 0
    z-index 1
    bottom calc(-1 * (var(--nav-block-border-b) + var(--nav-tab-drop)))
    height calc(var(--topbar-border-w) + var(--nav-tab-drop))
    background-color transparent
    pointer-events none
    transition background-color .3s, height var(--nav-tab-ease), bottom var(--nav-tab-ease)

  .navContent > .navItem > :is(.navBlock, .navSecond):is(:hover, :focus-visible)::after
    bottom calc(-1 * (var(--nav-block-border-b) + var(--nav-tab-drop-hover)))
    height calc(var(--topbar-border-w) + var(--nav-tab-drop-hover))
    background-color var(--nav-tab-color)

  // active 必须带 .navContent > .navItem 前缀才与上一条同为 (0,4,1)；
  // 靠源码序（active 在后）让当前页在悬停 / 聚焦时保持 3px 凸出，不被 hover 的 2px 压过。
  // active 只改色，几何由 base 单点承担（杜绝双源）
  .navContent > .navItem.active > :is(.navBlock, .navSecond)::after
    background-color var(--nav-tab-color)
