// ===== 顶栏响应式布局
// ≤1023px：☰ / 搜索图标按钮 + 顶栏下全宽下拉（菜单 / 搜索行）
@media ( max-width 1023px )
  .navBtn, .searchBtn
    display flex

  ol.navContent
    position absolute
    top 100%
    left 0
    right 0
    z-index 10
    box-sizing border-box
    max-height calc(100vh - var(--topbar-h))
    overflow-y auto
    flex-direction column
    align-items stretch
    background-color var(--theme-bg-trans0)
    visibility hidden
    opacity 0
    transform translateY(-6px)
    transition opacity .2s, transform .2s, visibility 0s .2s

  header.nav-open ol.navContent
    visibility visible
    opacity 1
    transform none
    transition opacity .2s, transform .2s

  .navContent > .navItem
    width 100%
    border-top 1px solid var(--theme-border-soft)
    &:first-child
      border-top unset

  .navContent > .navItem > :is(.navBlock, .navSecond)
    display flex
    align-items center
    flex-wrap wrap
    box-sizing border-box
    min-width 0
    justify-content flex-start
    min-height 48px
    padding 10px 20px

  .navContent .navItemTitle
    flex 1
    font-size 15px

  // 移动端 active 名称继续与图标成组（6px 间距）；桌面名称恒折叠（header.styl 的「中和一」把
  // margin-left 钉为 0），不占任何宽度，故桌面无成组间距可言
  // 选择器带 ol.navContent 前缀：特异性高于 header.styl 的同名规则（该文件编译序在后）
  ol.navContent .navItem.active > .navBlock .navItemLabel
    margin-left 6px

// ≥1024px：导航平铺 + 右侧常驻搜索框；☰ / 搜索图标按钮隐藏
@media ( min-width 1024px )
  // 选择器带 main 前缀：保证特异性高于 header.styl 的基础内边距（导入顺序在后）
  // 右侧内边距 0：右侧簇（社交图标 + 搜索框）紧贴视口右缘，无空白
  main header
    padding 0 0 0 24px

  .navBtn, .searchBtn
    display none

  ol.navContent
    height 100%

  .navContent > .navItem
    height 100%

  // 一级导航按内容自适应（border-box，高度 36px 与顶栏 36px 外高一致）：
  // min-width 归零、width auto，宽度完全由内容决定——左右内边距 9px×2 + 内容宽。
  // 两态内容宽相同：名称在桌面恒折叠（由 header.styl 桌面块的「中和一」拉平）、
  // 图标恒占满 --nav-icon-w 槽（「中和二」），故 active 与非 active 的按钮宽完全相等，
  // 切换当前页时其后按钮与右侧簇零位移（内边距取值只影响绝对宽度，不影响等宽与零位移）。
  // 内边距 9px：实机反馈要求「每个按钮宽度缩小 6px」（12px → 9px，左右各减 3px），
  // 按钮宽由 20px 槽 + 24px = 44px 收到 38px，接近方形更紧凑；栏外竖排标签宽跟随按钮
  // （见下方 ::before 规则由 left 0 / right 0 解出 = 包含块 = 按钮宽），故同步收为 38px。
  .navContent > .navItem > :is(.navBlock, .navSecond)
    box-sizing border-box
    width auto
    min-width 0
    height 36px
    display flex
    align-items center
    justify-content center
    padding 0 9px

  // 标题占满按钮可用宽度并水平居中：桌面端按钮内容只有图标槽，居中即图标居中
  .navContent > .navItem > :is(.navBlock, .navSecond) > .navItemTitle
    flex 1
    justify-content center

  // 底部凸出指示（仅桌面平铺态）：伪元素绝对定位、不参与布局，因此不改动按钮几何、
  // 不改动 nav 的对齐，也不加剧既有 1px 下沿溢出。锚点是 .navBlock 的 padding box 下沿
  // （y = 36，按钮已无栏内底边），向下让出凸出量后，伪元素总高 = 顶栏底边厚度 + 凸出量，
  // 故顶边恒为 y 35（顶栏外缘 y 36 的上沿），与顶栏末像素带重叠 → 无接缝；下沿 y 36 + 凸出量。
  // 凸出量由单一 --nav-tab-drop 决定，base 即最终几何（无第二处几何来源）
  .navContent > .navItem > :is(.navBlock, .navSecond)::after
    content ''
    position absolute
    left 0
    right 0
    z-index 1
    bottom calc(-1 * var(--nav-tab-drop))
    height calc(var(--topbar-border-w) + var(--nav-tab-drop))
    background-color transparent
    pointer-events none
    transition background-color .3s

  // active 与 hover / focus-visible 共用同一凸出几何与同一上色（同特异性 (0,4,1)），
  // 故合成一条规则以杜绝双源；状态区分改由按钮本体承担，不靠凸出尺寸：
  // active = 中度对比底色（桌面名称恒折叠，无展开项）；hover = 主题蓝块 + 白字；焦点另由焦点环承担
  .navContent > .navItem > :is(.navBlock, .navSecond):is(:hover, :focus-visible)::after,
  .navContent > .navItem.active > :is(.navBlock, .navSecond)::after
    background-color var(--nav-tab-color)

  // 选中项在栏外凸出段下方挂一枚「反色竖排文字框」（竖排如古文，高度随文字自适应）。
  //
  // 载体取 .navBlockIcon 的 ::before 伪元素 + attr(data-label)，本轮零 DOM 改动、零既有定位改动：
  //   1) 伪元素 position absolute 即脱流。CSS Flexbox §4 只把「流内」的 ::before / ::after
  //      变成弹性项，绝对定位者是 flex 容器的 out-of-flow 子盒、不参与弹性布局（等同
  //      position absolute 的流内子元素不占 flex 项位）。本仓已用同一手法承载上方 ::after
  //      凸出段并验证过不改动按钮几何，故此处结论对 ::before 同样成立。
  //      → 不新增 flex 项、.navItemTitle 的 flex 1 与按钮内边距 / 宽高全部不受影响。
  //   2) 定位基准是 .navBlockIcon 元素自身（.navBlock, .navSecond 基础层已是 position relative），
  //      因此把标签挂到按钮下沿之外不需要改动任何既有定位属性。
  //   3) 仅 .navBlockIcon 生效：无图标的项其 .navItemLabel 本身即可见文字，不该再挂重复标签。
  //   4) 凸出段已占用 ::after，标签用 ::before，两者互不冲突。
  //
  // 上沿取 calc(100% + var(--nav-tab-drop))：100% = 按钮 padding box 高 36px（= 凸出段的锚点），
  // 加同一个凸出量 token（该 token 已被凸出段消费一次，此处复用不改值），故上沿恒为
  // y 38 = 凸出段下沿（36 + 2px），两者严丝合缝、无缝也无重叠。
  //
  // 底色取 --nav-invert-bg（指向对面色板的「标签专用」顶栏底色 token，见 _core/color/base.styl 与
  // light.styl / dark.styl），前景色取既有 --theme-text-rev：浅色主题 = 深底白字、
  // 深色主题 = 浅底黑字，即「相反主题导航栏同背景」。
  // 该 token 现为完全不透明（alpha 1）：实机反馈先要求降到 60%，复核后改判为完全不透明——
  // 60% 会让标签文字对比度跌破 WCAG AA 的 4.5:1。完全不透明同时让对比度与背后内容彻底解耦
  // （不再需要「叠在正文上会不会发灰」的合成推算）。顶栏自身的 alpha 是另一对取值，见 base.styl。
  //
  // 显隐由「顶栏是否被指针 / 键盘占用」反向驱动（详见下方显形规则的注释）：标签默认隐藏，
  // 指针移出顶栏去读正文时即收起，故不会遮挡正文；点击穿透由 pointer-events none 全程承担。
  .navContent > .navItem > .navBlockIcon::before
    content attr(data-label)
    position absolute
    top calc(100% + var(--nav-tab-drop))
    left 0
    right 0
    // 高度随文字自适应：竖排下 inline 轴 = 纵向，故 height 即「字形前进宽 + 字间距」；
    // 不写死 height、也不用 min-height 撑
    height auto
    // 不声明 width、也不再用 auto 外边距居中：width auto 且 left / right 均非 auto 时，
    // 宽度由「left + margin + border + padding + width + right = 包含块宽」直接解出，
    // 标签 margin box 恰等于包含块（.navBlockIcon 的 padding box）= 按钮宽
    // （图标槽 --nav-icon-w 1.25em = 20px + 左右内边距 9px×2 = 38px），六项恒等、不随字数参差。
    //
    // 盒宽（38px）大于字列厚（line-height 1.25em = 20px，竖排下由 line-height 决定），
    // 故字列须沿 block 轴居中：vertical-rl 的 block 轴 = 横向且起点在右缘，不居中会贴右留白。
    // text-align 沿 inline 轴居中（此处 inline 轴 = 纵向），横向居中做不到，
    // 改由 flex 的交叉轴（= block 轴 = 横向）承担；主轴无富余（height auto 恰好包住文字），
    // 故只需 align-items、无需 justify-content。
    display flex
    align-items center
    // 物理上下各 6px：竖排下 inline 轴恰是物理纵向，故这是 inline 轴两端各留 6px
    // （实机反馈：原 3px 过紧）。横向内边距归零——宽度已跟随按钮，不再为文字让位
    padding 6px 0
    // 字间距 4px（实机反馈）：CSS Text 定义 letter-spacing 沿 inline 轴生效，竖排下 inline 轴
    // = 纵向，故只增大盒高、不影响盒宽——block 向尺寸仍由 line-height 决定（= 20px），
    // 与 38px 盒宽无冲突、不会把两字撑破盒宽。
    letter-spacing 4px
    z-index 2
    writing-mode vertical-rl
    text-orientation upright
    white-space nowrap
    // 顶栏声明的是 Bender（展示字体，无 CJK 字形），竖排中文须显式回到正文栈，
    // 与 #search-input（_modules/search/base.styl）取同一条栈
    font-family 'HarmonyOS Sans SC', 'Microsoft YaHei', 'PingFang SC', sans-serif
    // 竖排下 line-height 决定横向盒厚（block 轴），1.25em 让字形两侧各留 2px 余量
    line-height 1.25
    color var(--theme-text-rev)
    background-color var(--nav-invert-bg)
    // 标签悬在栏外、覆盖正文：不吃指针事件（点击穿透，WCAG 2.5.8 命中盒不变），
    // 且 visibility hidden 使非选中项完全不参与命中
    pointer-events none
    // 默认隐藏：显隐改由「顶栏是否被指针 / 键盘占用」驱动（见下方规则），
    // 故基础规则不再依赖 .active——指针离开顶栏去读正文时标签即收起，不再遮挡文字
    opacity 0
    visibility hidden
    // 退场：先淡出 .15s，再在 .15s 处切 visibility（否则淡出过程仍可被 AT 读到）
    transition opacity .15s, visibility 0s .15s

  // 显：仅当指针停留在顶栏内（含当前页按钮本身）或键盘焦点在顶栏内时显示。
  //
  // 为什么用「顶栏祖先态」反向驱动、而不是给标签自己写 :hover：
  // 标签自身一旦 :hover 就 opacity 0 → 立刻不再命中 :hover → 又显回来，来回闪烁。
  // 反向驱动是稳定的单向依赖：命中集合只由顶栏决定，标签的显隐不影响顶栏是否被命中。
  // 命中判据用后代组合器而非 :has()：指针在按钮上时 header 自身即匹配 :hover
  // （悬停后代会让祖先一并匹配），而标签带 pointer-events none 且几何上位于顶栏之外
  // （y 38 起，顶栏 0–36），故指针移向标签时 header 失配 → 标签收起，「移入拼接部分即隐藏」成立。
  // header 是 main 的子元素且 navBlockIcon 全在其中，命中集合与 main:has(header:hover) 等价，
  // 但不依赖 :has() 支持、不多写一层祖先约束。
  // 仍只对 .active 项显形：标签的用途是标出「当前页」是哪一页，全量六项同时弹出反而是噪音。
  // 进场：visibility 立即切、opacity 同步淡入（与退场同长，合计无堆叠）
  header:hover .navContent > .navItem.active > .navBlockIcon::before,
  header:focus-within .navContent > .navItem.active > .navBlockIcon::before
    opacity 1
    visibility visible
    transition opacity .15s, visibility 0s
