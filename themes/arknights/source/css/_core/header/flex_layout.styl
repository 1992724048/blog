// ===== 顶栏响应式布局
// ≤1023px：☰ / 搜索图标按钮 + 顶栏下全宽下拉（菜单 / 搜索行）
@media ( max-width 1023px )
  .navBtn, .searchBtn
    display flex

  ol.navContent
    position absolute
    top 100%
    left 0
    right 0
    z-index 10
    box-sizing border-box
    max-height calc(100vh - var(--topbar-h))
    overflow-y auto
    flex-direction column
    align-items stretch
    background-color var(--theme-bg-trans0)
    visibility hidden
    opacity 0
    transform translateY(-6px)
    transition opacity .2s, transform .2s, visibility 0s .2s

  header.nav-open ol.navContent
    visibility visible
    opacity 1
    transform none
    transition opacity .2s, transform .2s

  .navContent > .navItem
    width 100%
    border-top 1px solid var(--theme-border-soft)
    &:first-child
      border-top unset

  .navContent > .navItem > :is(.navBlock, .navSecond)
    display flex
    align-items center
    flex-wrap wrap
    box-sizing border-box
    min-height 48px
    padding 10px 20px

  .navContent .navItemTitle
    flex 1
    font-size 15px

// ≥1024px：导航平铺 + 右侧常驻搜索框；☰ / 搜索图标按钮隐藏
@media ( min-width 1024px )
  // 选择器带 main 前缀：保证特异性高于 header.styl 的基础内边距（导入顺序在后）
  // 右侧内边距 0：右侧簇（社交图标 + 搜索框）紧贴视口右缘，无空白
  main header
    padding 0 0 0 24px

  .navBtn, .searchBtn
    display none

  ol.navContent
    height 100%

  .navContent > .navItem
    height 100%

  .navContent > .navItem > .navBlock
    display flex
    align-items center
    height 100%
    padding 0 20px

  // 图标态菜单项：水平内边距收窄（按钮变窄），命中区仍为全高 36px（≥24px）
  .navContent > .navItem > .navBlock.navBlockIcon
    padding 0 12px
