// ===== 顶栏响应式布局
// ≤1023px：☰ / 搜索图标按钮 + 顶栏下全宽下拉（菜单 / 搜索行）
@media ( max-width 1023px )
  .navBtn, .searchBtn
    display flex

  ol.navContent
    position absolute
    top 100%
    left 0
    right 0
    z-index 10
    box-sizing border-box
    max-height calc(100vh - var(--topbar-h))
    overflow-y auto
    flex-direction column
    align-items stretch
    background-color var(--theme-bg-trans0)
    visibility hidden
    opacity 0
    transform translateY(-6px)
    transition opacity .2s, transform .2s, visibility 0s .2s

  header.nav-open ol.navContent
    visibility visible
    opacity 1
    transform none
    transition opacity .2s, transform .2s

  .navContent > .navItem
    width 100%
    border-top 1px solid var(--theme-border-soft)
    &:first-child
      border-top unset

  .navContent > .navItem > :is(.navBlock, .navSecond)
    display flex
    align-items center
    flex-wrap wrap
    box-sizing border-box
    min-width 0
    justify-content flex-start
    min-height 48px
    padding 10px 20px

  .navContent .navItemTitle
    flex 1
    font-size 15px

  // 移动端 active 名称继续与图标成组（6px 间距）；桌面固定宽度下由 header.styl 归零居中
  // 选择器带 ol.navContent 前缀：特异性高于 header.styl 的同名规则（该文件编译序在后）
  ol.navContent .navItem.active > .navBlock .navItemLabel
    margin-left 6px

// ≥1024px：导航平铺 + 右侧常驻搜索框；☰ / 搜索图标按钮隐藏
@media ( min-width 1024px )
  // 选择器带 main 前缀：保证特异性高于 header.styl 的基础内边距（导入顺序在后）
  // 右侧内边距 0：右侧簇（社交图标 + 搜索框）紧贴视口右缘，无空白
  main header
    padding 0 0 0 24px

  .navBtn, .searchBtn
    display none

  ol.navContent
    height 100%

  .navContent > .navItem
    height 100%

  // 一级导航固定 72x36（border-box，与顶栏 36px 外高一致）：active 项收起图标、名称展开时
  // 按钮宽度不变，消除后续按钮与右侧簇的横向位移；图标项与文字项的内部布局保持一致
  .navContent > .navItem > :is(.navBlock, .navSecond)
    box-sizing border-box
    width 72px
    min-width 72px
    height 36px
    display flex
    align-items center
    justify-content center
    padding 0

  // 标题占满按钮可用宽度并水平居中：名称的展开 / 收起不改变图标与名称的相对位置
  .navContent > .navItem > :is(.navBlock, .navSecond) > .navItemTitle
    flex 1
    justify-content center
