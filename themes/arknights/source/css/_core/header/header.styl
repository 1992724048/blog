:root
  // 顶栏高度：全断点统一 36px（border-box，含 1px 底边，内容区 35px）；--search-row-h 为移动端栏下整行搜索框高度（1px 上边框 + 栏高内容）
  --topbar-h 36px
  // 顶栏底边厚度：header 的 border-bottom 与导航凸出段共用，避免两处字面量漂移
  --topbar-border-w 1px
  --search-row-h calc(var(--topbar-h) + 1px)
  // 桌面一级导航（≥1024px）底部凸出指示：凸出量收敛为单一 token（实机反馈第二轮：
  // active 与 hover / focus-visible 同为 2px），尺寸不再承担状态区分，
  // 改由按钮本体的底色 / 文字色承担
  --nav-tab-drop 2px
  --nav-tab-color var(--theme-highlight)
  // 桌面一级导航的图标槽宽：取各 menu_icons 字形 advance 的最大值，em 声明随页面缩放同步（WCAG 1.4.4）。
  // 实测 fa-solid-900.ttf（UPEM 512）的 hmtx advance（.temp/fa-font-metrics.js 复算，门禁逐字形断言）：
  // fa-link 640 → 1.25em（最宽）、fa-house / fa-folder-open 576 → 1.125em、
  // fa-circle-info / fa-box-archive 512 → 1em、fa-database 448 → 0.875em（最窄），极差 0.375em。
  // 槽宽取最大值 1.25em 的理由：既保证任何字形都不被裁切（advance ≤ 槽宽），又使图标明显小于
  // 两个汉字的名称宽（2em），消除「图标与文字等大」的观感；固定槽宽同时把各字形 advance
  // 差异移出布局计算，从根上消除「友链项比其它项宽」的字形差异。
  --nav-icon-w 1.25em

header
  position sticky
  top 0
  z-index 15
  box-sizing border-box
  width 100%
  height var(--topbar-h)
  display flex
  align-items center
  padding 0 12px
  font-family Bender
  // 毛玻璃顶栏：底色 alpha 按主题降至 0.85（见下），blur 观感依赖底色透出
  background-color var(--theme-bg-trans0)
  -webkit-backdrop-filter blur(8px)
  backdrop-filter blur(8px)
  // 顶栏底边：与首页文章列表条目边框同色（--theme-unimportant 两主题 #767676 / #898989），随主题自动适配
  border-bottom var(--topbar-border-w) solid var(--theme-unimportant)

// 毛玻璃底色：仅覆盖顶栏（取 --theme-bg-trans0 原色值降 alpha），弹层 / 下拉仍用 --theme-bg-trans0
// 取值来自 _core/color/base.styl 的常驻 token（--topbar-bg-light / --topbar-bg-dark）：
// 导航选中项栏外竖排标签的反色底经 --nav-invert-bg 指向对面那一条，两处不再各持一份字面量
:root[theme-mode=light] header
  background-color var(--topbar-bg-light)
:root[theme-mode=dark] header
  background-color var(--topbar-bg-dark)

// 回退：不支持 backdrop-filter（含 -webkit- 前缀）时维持原 0.95 高不透明底，保证文字可读性
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)))
  :root[theme-mode=light] header,
  :root[theme-mode=dark] header
    background-color var(--theme-bg-trans0)

nav
  flex 1
  min-width 0
  height 100%
  display flex
  align-items center
  white-space nowrap

// 基础 flex 容器：桌面 row 平铺；≤1023px 由 flex_layout.styl 覆盖为 column 下拉
ol.navContent
  display flex
  margin 0
  padding 0
  list-style none

// ≥1024 右簇右锚：自动边距改由菜单列表右侧承担（社交块被广告拦截隐藏 / 移除后，右簇仍整体贴右；
// 原 .topbar-social margin-left auto 在元素 display:none 后锚即失效）。
// 须晚于上方 margin 0 生效：本文件编译序在 flex_layout.styl 之后，同文件按源码序即可
//
// 同一断点还负责把「图标 ↔ 名称」的两态互换整个中和掉：桌面平铺态按钮恒显图标、恒不展开名称。
// 下方基础层的两态机制（active 名称展开 + active 图标收拢，连同各自的顺序化过渡）只服务 ≤1023px
// 的栏下下拉，本块用两条更高特异性的规则把两态取值拉平——基础规则的声明一行不动。
@media ( min-width 1024px )
  ol.navContent
    margin-right auto

  // 中和一 · 名称恒折叠：特异性 (0,4,1) = 4 类 + 1 类型，高于基础 active 展开规则
  // .navItem.active > .navBlock .navItemLabel 的 (0,4,0)，故与编译序无关、恒定生效。
  // 一条规则同时命中 active 与非 active（active 项同样带 .navItem），因此六项按钮的内容宽
  // 恒等于图标槽 --nav-icon-w，切换当前页不再有任何位移。
  // 名称既不删除也不用 display none：仍在可访问性树内（可访问名称由 a 的 aria-label 提供，
  // 视觉名称另有 title 悬停提示），折叠机制与移动端同源（max-width + opacity）。
  ol.navContent .navItem > .navBlock .navItemLabel
    max-width 0
    margin-left 0
    opacity 0

  // 中和二 · 图标恒可见：特异性 (0,5,2) = 5 类 + 2 类型，高于基础 active 收拢规则
  // .navItem.active > .navBlockIcon > .navItemTitle > i 的 (0,4,1)。
  // 只回写被 active 规则改掉的两项；width / overflow / text-align 仍由基础图标槽规则承担。
  // 两态取值相同 → 基础层的顺序化过渡在桌面恒不触发（无值变化即无过渡），
  // 故桌面无须另关 transition，减动效清单也无需摘除那两条基础规则。
  ol.navContent .navItem.active > .navBlockIcon > .navItemTitle > i
    max-width var(--nav-icon-w)
    opacity 1

.navItem
  position relative
  display block
  margin 0

.navBlock, .navSecond
  position relative
  display block
  color var(--theme-text-light)
  transition background-color .3s, color .3s

.navItemTitle
  position relative
  display block
  box-sizing border-box
  overflow-wrap break-word
  transition color .3s

// hover（非当前页）：蓝块 + 白字（深浅色主题统一；覆盖 change.styl 的标题文字阴影）
// 按下（:active）时 :hover 仍命中本规则（特异性高于全局 a:active 黄底），白字始终压蓝块
.navBlock:hover,
.navSecond:hover
  background-color var(--theme-highlight)
  & > .navItemTitle
    color #fff
    text-shadow none

// 当前页（.active 由 Header.ts 挂载）：沿用归档 / 分类列表项的选中语言——中度对比底色。
// 底部不再有栏内底边（实机反馈第三轮：栏内 2.5px 蓝边与栏外 2px 凸出接成约 4.5px 的一段，偏粗），
// 指示线只保留栏外凸出段；状态区分不靠颜色单独表达（WCAG 1.4.1）：≤1023px 由「底色 + 名称展开 +
// 栏外凸出」承载，桌面平铺态名称恒折叠（见本文件桌面块的「中和一」），
// 故桌面只剩「底色 + 栏外凸出」两项。
// 特异性 (0,3,0) 高于上方 hover 的 (0,2,0)：选中项悬停时保持选中样式，不闪蓝块 / 白字
// 注：Stylus 的 & 嵌套在 :is() 选择器下会错插进首个参数，标题规则须平铺书写
.navItem.active > :is(.navBlock, .navSecond)
  background-color var(--theme-bg-soft-hover)

.navItem.active > :is(.navBlock, .navSecond) > .navItemTitle
  color var(--theme-text-light)
  text-shadow none

// 图标态菜单项（menu_icons 配置生效）：图标随标题继承色 / 悬停反色，尺寸随菜单字号
// 图标渲染在 .navItemTitle 内（避免触发子菜单展开箭头选择器的「非仅子」判定）
.navBlockIcon > .navItemTitle
  display flex
  align-items center

// 图标：当前页时收拢淡出；槽宽固定为 --nav-icon-w（字形居中、不裁切），
// 使 FontAwesome 各字形 0.875–1.25em 不等的 advance 不再进入布局计算（实测 fa-link 1.25em /
// fa-database 0.875em，跨度 0.375em，正是「友链项更宽」的根因）。
// .navItemTitle 为 flex 容器，图标作为弹性项可直接过渡 max-width；overflow hidden 兼作裁切与解除弹性项自动最小尺寸
// 过渡为「顺序化」的一半（延迟 .15s）：离开当前页时名称先收起、图标随后展开（见 .navItemLabel 注释）
// 适用断点：≤1023px 的栏下下拉。桌面平铺态由本文件桌面块内的
// 「中和二」把两态拉平，基础声明保持原样
.navBlockIcon > .navItemTitle > i
  width var(--nav-icon-w)
  max-width var(--nav-icon-w)
  overflow hidden
  text-align center
  transition max-width .15s .15s, opacity .15s .15s

// 进入当前页：图标立即收拢淡出（无延迟），为随后展开的名称让出位置（≤1023px；桌面由「中和二」覆盖）
.navItem.active > .navBlockIcon > .navItemTitle > i
  max-width 0
  opacity 0
  transition max-width .15s, opacity .15s

// 名称（active 项显示）：默认收起（0 宽 + 透明），随 active 平滑展开；类名避开 Header.ts 识别集合
// margin-left 归零配合 .navItemTitle 的 flex 1 + 居中，使名称在按钮内居中；
// ≤1023px 由 flex_layout.styl 覆盖回 6px，保持图标 + 名称成组
// 过渡同样顺序化：收起方向立即（.15s），展开方向延迟 .15s。两段合计 .3s，与原同节奏总时长一致，
// 但图标与名称不再同时占位 → 过渡期内容宽度恒 ≤ max(图标槽, 名称)，不出现二者相加的占位峰值。
// 适用断点：≤1023px 的栏下下拉。桌面平铺态由本文件桌面块内的
// 「中和一」令名称恒折叠（两态同值），故下面的两态宽度差与顺序化过渡在桌面都不再发生
.navItemLabel
  display inline-block
  max-width 0
  margin-left 0
  opacity 0
  overflow hidden
  white-space nowrap
  transition max-width .15s, opacity .15s, margin-left .15s
.navItem.active > .navBlock .navItemLabel
  max-width 5em
  margin-left 0
  opacity 1
  transition max-width .15s .15s, opacity .15s .15s, margin-left .15s .15s

// 移动端下拉行标题默认两端对齐（navSecond.styl）：图标态改为左对齐（图标 + 名称成组）
.navContent .navBlockIcon > .navItemTitle
  justify-content flex-start

// 焦点环：内缩的主题反差色，避免主题蓝在浅色底上对比不足（WCAG 2.4.7 / 1.4.11）
:is(.navBtn, .searchBtn, .navBlock, .navSecond, #search-input, .topbar-social a):focus-visible
  outline 2px solid var(--theme-text-light)
  outline-offset -2px

// 减动效横切块：覆盖元素集合与拆分前逐条一致（header / ol.navContent / 搜索相关 / 名称两态 /
// 图标两态 / 桌面凸出段 / 桌面选中项栏外竖排标签），只是按逻辑分组拆成短规则——原先挤在一行的
// 超长逗号列表一旦被误写成嵌套规则就会编译出重复片段（ol.navContent .navContent > ...），
// 拆分后每个选择器独立成行，风险面收敛且新增条目不必再挤进一行
@media (prefers-reduced-motion: reduce)
  header, ol.navContent, #search-header, .search-popup, .navBtnIconBar
    transition none
  .navItemLabel, .navItem.active > .navBlock .navItemLabel
    transition none
  .navBlockIcon > .navItemTitle > i, .navItem.active > .navBlockIcon > .navItemTitle > i
    transition none
  .navContent > .navItem > :is(.navBlock, .navSecond)::after
    transition none
  // 竖排标签的进 / 退场时序（flex_layout.styl 桌面块）：降为瞬时——transition none 后
  // opacity 与 visibility 同帧生效；声明点与该规则同文件外，用完整选择器保持唯一
  .navContent > .navItem > .navBlockIcon::before,
  .navContent > .navItem.active > .navBlockIcon::before
    transition none

// 注：≥1024px 桌面顶栏平铺布局与 ≤1023px 栏下下拉布局见 flex_layout.styl
