:root
  // 顶栏高度：全断点统一 46px；--search-row-h 为移动端栏下整行搜索框高度（1px 上边框 + 栏高内容）
  --topbar-h 46px
  --search-row-h calc(var(--topbar-h) + 1px)

header
  position sticky
  top 0
  z-index 15
  box-sizing border-box
  width 100%
  height var(--topbar-h)
  display flex
  align-items center
  padding 0 12px
  font-family Bender
  background-color var(--theme-bg-trans0)

nav
  flex 1
  min-width 0
  height 100%
  display flex
  align-items center
  white-space nowrap

// 基础 flex 容器：桌面 row 平铺；≤1023px 由 flex_layout.styl 覆盖为 column 下拉
ol.navContent
  display flex
  margin 0
  padding 0
  list-style none

.navItem
  position relative
  display block
  margin 0

.navBlock, .navSecond
  position relative
  display block
  color var(--theme-text-light)
  transition background-color .3s, color .3s

.navItemTitle
  position relative
  display block
  box-sizing border-box
  overflow-wrap break-word
  transition color .3s

// hover / 当前页：蓝块 + 黑字（覆盖 change.styl 的标题文字阴影）
.navBlock:hover,
.navSecond:hover,
.navItem.active > .navBlock,
.navItem.active > .navSecond
  background-color var(--theme-highlight)
  & > .navItemTitle
    color var(--theme-text-hover)
    text-shadow none

// 焦点环：内缩的主题反差色，避免主题蓝在浅色底上对比不足（WCAG 2.4.7 / 1.4.11）
:is(.navBtn, .searchBtn, .navBlock, .navSecond, #search-input):focus-visible
  outline 2px solid var(--theme-text-light)
  outline-offset -2px

@media (prefers-reduced-motion: reduce)
  header, ol.navContent, #search-header, .search-popup, .navBtnIconBar
    transition none

// 注：≥1024px 桌面顶栏平铺布局与 ≤1023px 栏下下拉布局见 flex_layout.styl
