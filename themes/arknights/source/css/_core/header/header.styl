:root
  // 顶栏高度：全断点统一 36px（border-box，含 1px 底边，内容区 35px）；--search-row-h 为移动端栏下整行搜索框高度（1px 上边框 + 栏高内容）
  --topbar-h 36px
  --search-row-h calc(var(--topbar-h) + 1px)

header
  position sticky
  top 0
  z-index 15
  box-sizing border-box
  width 100%
  height var(--topbar-h)
  display flex
  align-items center
  padding 0 12px
  font-family Bender
  // 毛玻璃顶栏：底色 alpha 按主题降至 0.85（见下），blur 观感依赖底色透出
  background-color var(--theme-bg-trans0)
  -webkit-backdrop-filter blur(8px)
  backdrop-filter blur(8px)
  // 顶栏底边：与首页文章列表条目边框同色（--theme-unimportant 两主题 #767676 / #898989），随主题自动适配
  border-bottom 1px solid var(--theme-unimportant)

// 毛玻璃底色：仅覆盖顶栏（取 --theme-bg-trans0 原色值降 alpha），弹层 / 下拉仍用 --theme-bg-trans0
:root[theme-mode=light] header
  background-color rgba(#f4f5f6, .85)
:root[theme-mode=dark] header
  background-color rgba(20, 21, 22, .85)

// 回退：不支持 backdrop-filter（含 -webkit- 前缀）时维持原 0.95 高不透明底，保证文字可读性
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)))
  :root[theme-mode=light] header,
  :root[theme-mode=dark] header
    background-color var(--theme-bg-trans0)

nav
  flex 1
  min-width 0
  height 100%
  display flex
  align-items center
  white-space nowrap

// 基础 flex 容器：桌面 row 平铺；≤1023px 由 flex_layout.styl 覆盖为 column 下拉
ol.navContent
  display flex
  margin 0
  padding 0
  list-style none

// ≥1024 右簇右锚：自动边距改由菜单列表右侧承担（社交块被广告拦截隐藏 / 移除后，右簇仍整体贴右；
// 原 .topbar-social margin-left auto 在元素 display:none 后锚即失效）。
// 须晚于上方 margin 0 生效：本文件编译序在 flex_layout.styl 之后，同文件按源码序即可
@media ( min-width 1024px )
  ol.navContent
    margin-right auto

.navItem
  position relative
  display block
  margin 0

.navBlock, .navSecond
  position relative
  display block
  color var(--theme-text-light)
  transition background-color .3s, color .3s

.navItemTitle
  position relative
  display block
  box-sizing border-box
  overflow-wrap break-word
  transition color .3s

// hover（非当前页）：蓝块 + 白字（深浅色主题统一；覆盖 change.styl 的标题文字阴影）
// 按下（:active）时 :hover 仍命中本规则（特异性高于全局 a:active 黄底），白字始终压蓝块
.navBlock:hover,
.navSecond:hover
  background-color var(--theme-highlight)
  & > .navItemTitle
    color #fff
    text-shadow none

// 当前页（.active 由 Header.ts 挂载）：沿用归档 / 分类列表项的选中语言——左缘 5px 主题蓝条（--theme-highlight）+ 中度对比底色（--theme-bg-soft-hover）；
// 特异性 (0,3,0) 高于上方 hover 的 (0,2,0)：选中项悬停时保持选中样式，不闪蓝块 / 白字
// 注：Stylus 的 & 嵌套在 :is() 选择器下会错插进首个参数，标题规则须平铺书写
.navItem.active > :is(.navBlock, .navSecond)
  background-color var(--theme-bg-soft-hover)
  border-left 5px solid var(--theme-highlight)

.navItem.active > :is(.navBlock, .navSecond) > .navItemTitle
  color var(--theme-text-light)
  text-shadow none

// 图标态菜单项（menu_icons 配置生效）：图标随标题继承色 / 悬停反色，尺寸随菜单字号
// 图标渲染在 .navItemTitle 内（避免触发子菜单展开箭头选择器的「非仅子」判定）
.navBlockIcon > .navItemTitle
  display flex
  align-items center

// 图标：当前页时收拢淡出，与名称展开同节奏（.3s），避免状态跳变；max-width 上限 1.5em（FontAwesome 实宽 ≤1.25em，留余量）
// .navItemTitle 为 flex 容器，图标作为弹性项可直接过渡 max-width；overflow hidden 兼作裁切与解除弹性项自动最小尺寸
.navBlockIcon > .navItemTitle > i
  max-width 1.5em
  overflow hidden
  transition max-width .3s, opacity .3s

.navItem.active > .navBlockIcon > .navItemTitle > i
  max-width 0
  opacity 0

// 名称（active 项显示）：默认收起（0 宽 + 透明），随 active 平滑展开；类名避开 Header.ts 识别集合
.navItemLabel
  display inline-block
  max-width 0
  margin-left 0
  opacity 0
  overflow hidden
  white-space nowrap
  transition max-width .3s, margin-left .3s, opacity .3s
.navItem.active > .navBlock .navItemLabel
  max-width 5em
  margin-left 6px
  opacity 1

// 左蓝条占位补偿：选中项左内边距按断点各语境 −5px（对应 flex_layout / navSecond 的原左距），
// 条目宽度与内容起点同未选中态一致，路由切换不产生 ±5px 横向位移
@media ( max-width 1023px )
  .navContent > .navItem.active > :is(.navBlock, .navSecond)
    padding-left 15px

@media ( min-width 1024px )
  .navContent > .navItem.active > .navBlock
    padding-left 15px
  .navContent > .navItem.active > .navBlock.navBlockIcon
    padding-left 7px
  .navItemList > .navItem.active > :is(.navBlock, .navSecond)
    padding-left 11px

// 移动端下拉行标题默认两端对齐（navSecond.styl）：图标态改为左对齐（图标 + 名称成组）
.navContent .navBlockIcon > .navItemTitle
  justify-content flex-start

// 焦点环：内缩的主题反差色，避免主题蓝在浅色底上对比不足（WCAG 2.4.7 / 1.4.11）
:is(.navBtn, .searchBtn, .navBlock, .navSecond, #search-input, .topbar-social a):focus-visible
  outline 2px solid var(--theme-text-light)
  outline-offset -2px

@media (prefers-reduced-motion: reduce)
  header, ol.navContent, #search-header, .search-popup, .navBtnIconBar, .navItemLabel, .navBlockIcon > .navItemTitle > i
    transition none

// 注：≥1024px 桌面顶栏平铺布局与 ≤1023px 栏下下拉布局见 flex_layout.styl
