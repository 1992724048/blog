.navBtn, .searchBtn
  flex none
  align-items center
  justify-content center
  box-sizing border-box
  width 44px
  height 44px
  padding 0
  color var(--theme-btn-bg)
  background-color transparent
  transition background-color .3s
  &:active
    background-color var(--theme-bg-soft)
.navBtnIcon
  position relative
  display block
  width 20px
  height 20px
.navBtnIconBar
  position absolute
  left 0
  top 50%
  width 20px
  height 2px
  background-color var(--theme-btn-bg)
  text-indent 101%
  white-space nowrap
  overflow hidden
  transition transform ease-in-out .3s
  box-shadow 0 0 5px var(--theme-bg-hover), 0 0 5px var(--theme-bg-hover)
  &:nth-child(1)
    transform translate(0, -7px)
  &:nth-child(2)
    transform translate(0, -1px)
  &:nth-child(3)
    transform translate(0, 5px)

// 展开态：☰ → ✕
header.nav-open .navBtnIconBar
  box-shadow unset
  &:nth-child(1)
    transform translate(0, -1px) rotate(45deg)
  &:nth-child(2)
    transform translate(0, -1px) scaleX(0)
  &:nth-child(3)
    transform translate(0, -1px) rotate(-45deg)

.searchBtnIcon
  display block
  width 20px
  height 20px
