:root[theme-mode=dark]
  --cursor-data var(--dark-cursor)
  --body-background var(--dark-background)

  --theme-highlight #2bf
  --theme-subcolor #fe2
  --theme-stress #C0392B

  --theme-bar-color-0 #fe2
  --theme-bar-color-1 #fe2a
  --theme-bar-color-2 #fe24
  --theme-bar-color-3 #fe22

  --theme-kbd-shadow #ba2
  --theme-kbd-text #000

  --theme-cursor #ccc
  --theme-cursor-bg #fff8

  --theme-text-hover #000

  --theme-text #c4c4c4
  --theme-text-light #fff
  // 反色强调对（反色设计已对调）：与下方 --theme-bg-light 互为反差，可作前景或实心块底色
  --theme-text-rev #fff

  --theme-background #141516
  --theme-bg-trans0 rgba(20, 21, 22, 0.95)
  --theme-bg-trans1 rgba(20, 21, 22, 0.8)
  --theme-bg-trans2 rgba(50, 52, 54, 0.8)
  --theme-bg-hover #000

  // 反色强调对的成对底色：与 --theme-text-rev 互为反差
  --theme-bg-light #000
  --theme-bg-soft rgba(#fff, .05)
  --theme-bg-soft-hover rgba(#fff, .1)

  --theme-ex-header rgba(#fff, .3)

  --theme-btn-bg #d4d8dd

  --theme-border  #fe2
  --theme-border-light #fff
  --theme-border-soft rgba(#fff, .1)

  --theme-unimportant #898989
  --theme-unimportant-trans #89898966
  --theme-unimportant-2 #535353

  // --theme-unimportant 向白混 15%（8-bit 四舍五入）：#898989 -> #9b9b9b
  --embed-muted #9b9b9b

  --theme-td-border #2bf
  --theme-td-hover rgba(#2bf, .1)

  --theme-tag-bg #313131
  --theme-tag-count-bg #494949
  --theme-tag-border #313131

  --theme-loadingbar #fff
  --theme-loadingbar-fail #f00

  // 顶栏搜索框（盒体与输入框同底色）：深色主题黑底白字
  --theme-search-bg #000
  --theme-search-text #fff
  --theme-search-placeholder #b0b0b0
